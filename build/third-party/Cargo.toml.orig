winnow-1 = { package = "winnow", version = "1.0.3", features = ["alloc", "ascii", "binary", "memchr", "parser", "std"] }
wiremock = { version = "0.6.5" }
wit-bindgen = { version = "0.57.1", features = ["async", "bitflags", "macro-string", "macros", "realloc", "std", "wit-bindgen-rust-macro"] }
wit-bindgen-core = { version = "0.57.1" }
wit-bindgen-core-0-59 = { package = "wit-bindgen-core", version = "0.59.0" }
wit-bindgen-rust = { version = "0.57.1" }
wit-bindgen-rust-0-59 = { package = "wit-bindgen-rust", version = "0.59.0" }
wit-bindgen-rust-macro = { version = "0.57.1" }
wit-component = { version = "0.253.0" }
wit-parser = { version = "0.253.0", features = ["decoding", "serde", "serde_derive", "serde_json", "std", "wasmparser"] }
writeable = { version = "0.6.3", features = ["alloc"] }
xattr = { version = "1.6.1", features = ["unsupported"] }
xxhash-rust = { version = "0.8.15", features = ["xxh64"] }
yansi = { version = "1.0.1", features = ["alloc", "detect-tty", "is-terminal", "std"] }
yoke = { version = "0.8.3", features = ["alloc", "derive", "yoke-derive", "zerofrom"] }
yoke-derive = { version = "0.8.2" }
zerocopy = { version = "0.8.52", features = ["derive", "simd", "zerocopy-derive"] }
zerocopy-derive = { version = "0.8.52" }
zerofrom = { version = "0.1.8", features = ["alloc", "derive", "zerofrom-derive"] }
zerofrom-derive = { version = "0.1.7" }
zeroize = { version = "1.9.0", features = ["alloc"] }
zerotrie = { version = "0.2.4", features = ["yoke", "zerofrom"] }
zerovec = { version = "0.11.6", features = ["alloc", "derive", "serde", "yoke", "zerovec-derive"] }
zerovec-derive = { version = "0.11.3" }
zlib-rs = { version = "0.6.5", features = ["c-allocator", "rust-allocator", "std"] }
zmij = { version = "1.0.21" }
zstd = { version = "0.13.3", features = ["arrays", "experimental", "legacy", "zdict_builder"] }
zstd-safe = { version = "7.2.4", features = ["arrays", "experimental", "legacy", "std", "zdict_builder"] }
zstd-sys = { version = "2.0.16+zstd.1.5.7", features = ["experimental", "legacy", "std", "zdict_builder"] }
