[workspace]

[package]
name = "third-party"
version = "0.0.0"
edition = "2021"

[lib]
path = "lib.rs"

[dependencies]
adler2 = { version = "2.0.1", features = ["std"] }
ahash = { version = "0.7.8", features = ["std"] }
aho-corasick = { version = "1.1.4", features = ["perf-literal", "std"] }
alloc-no-stdlib = { version = "2.0.4" }
alloc-stdlib = { version = "0.2.4" }
allocative = { version = "0.3.6", features = ["hashbrown"] }
allocative_derive = { version = "0.3.6" }
allocator-api2 = { version = "0.2.21", features = ["alloc", "std"] }
android_system_properties = { version = "0.1.5" }
anstream = { version = "0.6.21", features = ["anstyle-query", "anstyle-wincon", "auto", "wincon"] }
anstream-1 = { package = "anstream", version = "1.0.0", features = ["anstyle-query", "anstyle-wincon", "auto", "wincon"] }
anstyle = { version = "1.0.14", features = ["std"] }
anstyle-parse = { version = "0.2.7", features = ["utf8", "utf8parse"] }
