anstyle-wincon = { version = "3.0.11" }
anyhow = { version = "1.0.103", features = ["std"] }
append-only-vec = { version = "0.1.8" }
arborium = { version = "2.18.1", features = ["arborium-go", "arborium-java", "arborium-javascript", "arborium-nix", "arborium-python", "arborium-rust", "arborium-tsx", "arborium-typescript", "lang-go", "lang-java", "lang-javascript", "lang-nix", "lang-python", "lang-rust", "lang-tsx", "lang-typescript"] }
