+/// Run the full rustdoc JSON pass with `at_args` (identical to the argv that
+/// cargo passes to the system rustdoc), capture the assembled `Crate` value
+/// **in memory**, and return it serialised to JSON bytes.
+///
+/// No JSON file is written.  The caller (rustdoc-driver) deserialises the bytes
+/// into `rustdoc_types::Crate` and lowers directly to IR.
+///
+/// # Errors
+/// Returns an error string if the compilation or doc pass failed, or if the
+/// capture slot was unexpectedly empty after the run.
+pub fn capture_crate(
+    at_args: Vec<String>,
+) -> Result<Vec<u8>, Box<dyn std::error::Error + Send + Sync>> {
+    // Reset the slot from any previous call, then enable capture mode.
+    {
+        let mut slot = CAPTURE_SLOT.lock().map_err(|e| e.to_string())?;
+        *slot = None;
+    }
+    CAPTURE_MODE.store(true, Ordering::SeqCst);
+
+    // Drive the full rustdoc pipeline.  run_from_commandline is the same entry
+    // point cargo invokes; it returns the process exit code.
+    let dcx = rustc_errors::EarlyDiagCtxt::new(
+        rustc_session::config::ErrorOutputType::default(),
+    );
+    let exit_code = crate::run_from_commandline(at_args, &dcx);
+
+    CAPTURE_MODE.store(false, Ordering::SeqCst);
+
+    if exit_code != 0 {
+        return Err(format!("rustdoc exited with code {exit_code}").into());
+    }
+
+    let bytes = CAPTURE_SLOT
+        .lock()
+        .map_err(|e| e.to_string())?
+        .take()
+        .ok_or("capture_crate: slot empty after successful run")?;
+
+    Ok(bytes)
+}
