+/// When true, after_krate stores the assembled Crate in CAPTURE_SLOT instead of
+/// writing JSON to disk.  Set only by capture_crate(); never mutated concurrently.
+static CAPTURE_MODE: AtomicBool = AtomicBool::new(false);
+
+/// Receives the assembled Crate when CAPTURE_MODE is true.
+static CAPTURE_SLOT: Mutex<Option<Vec<u8>>> = Mutex::new(None);
+
