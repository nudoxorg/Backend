# crates check — native dependency-graph check (BXL).
#
# Enumerates every rust_library / rust_binary / rust_test under //workspace/...
# using an unconfigured query (no network, no rustc) and prints them sorted,
# plus a JSON summary.
#
# Run:
#   buck2 bxl //build/third-party/tools:check.bxl:check
#
# Merely resolving these targets is itself a consistency check: //build/rust.bzl
# defines `crate()`/`workspace()` helpers that `fail()` at load time on an
# unknown crate or member, so a typo'd / unvendored reference makes even this
# enumeration error out — no build required.
#
# Correctness over ambition: this is intentionally modest. To additionally force
# resolution of every *transitive* edge you can layer on a deps() walk, e.g.
#
#     all_deps = ctx.uquery().deps(targets)
#     ctx.output.print("transitive:", len(all_deps))
#
# That is deliberately omitted here because deps() surfaces (and hard-fails on)
# pre-existing broken edges in workspace BUCK files this tool does not own; the
# plain enumeration above stays green and is the guaranteed entrypoint.

def _impl(ctx: bxl.Context) -> None:
    universe = "//workspace/..."
    kind_re = "^(rust_binary|rust_library|rust_test)$"

    targets = ctx.uquery().kind(kind_re, universe)

    labels = sorted([str(t.label) for t in targets])
    for label in labels:
        ctx.output.print(label)

    ctx.output.print_json({
        "universe": universe,
        "rust_targets": len(labels),
    })

check = bxl_main(
    impl = _impl,
    cli_args = {},
)
