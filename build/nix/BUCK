# build/nix is a plain Nix package set (packages.nix), not a flake.
# Buck2 hermetic toolchains use the thin flake at toolchains//nix:flake —
# see build/toolchains/BUCK flake.package(path = "toolchains//nix:flake").
#
# This package only exposes non-flake Nix sources that other Buck targets
# may materialize (e.g. snowydeer helpers under this tree).
filegroup(
    name = "nix-sources",
    srcs = [
        "packages.nix",
        "backend-image.nix",
        "compiler.nix",
        "compiler-image.nix",
        "buck2-artifact.json",
    ],
    visibility = ["PUBLIC"],
)
