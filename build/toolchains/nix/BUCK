# Flake source target consumed by buck2.nix's flake.package(path = ...).
#
# `flake.package`'s `path` attr is an `attrs.source(allow_directory = True)`, so
# it needs a target that exposes the flake directory (flake.nix + flake.lock) as
# a single source artifact. buck2.nix's own examples use a `filegroup` named
# `flake` for exactly this (examples/toolchains/nix/BUCK). References in
# build/toolchains/BUCK point at `//build/toolchains/nix:flake`.
filegroup(
    name = "flake",
    srcs = [
        "flake.lock",
        "flake.nix",
    ],
    visibility = ["PUBLIC"],
)
