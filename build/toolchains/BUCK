# buck2.nix external cell (see .buckconfig [external_cells] nix = git). Provides
# hermetic Nix-built toolchains via flake.package(). Run `buck2 kill` after the
# cell config changes.
load("@nix//:flake.bzl", "flake")
load("@nix//toolchains:rust.bzl", "nix_rust_toolchain")

# ── Toolchain selection toggle ───────────────────────────────────────────────
#
# Controlled by [nix] toolchain in .buckconfig (set by the devshell hook):
#   0 (default) — system toolchains; @nix cell resolves to build/nix-stub stubs.
#   1           — hermetic Nix toolchains via buck2.nix; action cache keys depend
#                 on pinned Nix store closures rather than ambient machine state,
#                 so results are reproducible and shareable via the Attic cache.
#
# The Nix devshell startup hook in flake.nix appends a NIX-GENERATED block to
# .buckconfig that sets `[nix] toolchain = 1` and overrides the @nix cell to
# the real buck2.nix source via `[external_cells] nix = path`.  Without the
# devshell, this block is absent and system toolchains are used automatically.
# Opt out even inside the devshell: `buck2 build -c nix.toolchain=0 //...`
#
# Must use read_root_config: this file lives in the `toolchains` cell, and
# `read_config` only sees that cell's own buckconfig (which has no [nix]
# section). The devshell writes `[nix] toolchain = 1` into the root
# .buckconfig; without root-config lookup we silently fall back to the
# system rustc on PATH (often an older rustup nightly), which breaks
# pipelined builds via -Zno-codegen SVH mismatches (E0460/E0463).
_use_nix = read_root_config("nix", "toolchain", "0") in ("1", "true", "True")

# `flake.package` runs `nix build path:<dir>#packages.<system>.<pkg>.out` as a
# Buck2 action; the building host just needs `nix` on PATH. `toolchains//nix:flake`
# (toolchains-cell-relative) is the filegroup exposing flake.nix + flake.lock.
_TARGET_MAPPING = [
    select({k: k for k in [
        "config//os:linux",
        "config//os:macos",
    ]}),
    select({k: k for k in [
        "config//cpu:arm64",
        "config//cpu:x86_64",
    ]}),
]

# ── C/C++ ──────────────────────────────────────────────────────────────────
#
# NIX set (default): flake.package `cxx` output wraps the nixpkgs stdenv cc
# (clang on Darwin, clang+binutils on Linux) capturing the NIX_* env, exposing
# cc/c++/ar/nm/ranlib/strip/objcopy under bin/. Hermetic; no ambient /usr/bin.
flake.package(
    name = "nix_cc",
    binaries = [
        "ar",
        "cc",
        "c++",
        "nm",
        "objcopy",
        "ranlib",
        "strip",
    ],
    package = "cxx",
    path = "toolchains//nix:flake",
    target_compatible_with = _TARGET_MAPPING,
)

nix_cxx_toolchain(
    name = "cxx_nix",
    nix_cc = ":nix_cc",
    visibility = ["PUBLIC"],
)

# SYSTEM set (escape hatch): absolute-path clang tools. Uses absolute paths so
# cc-rs build scripts can invoke the compiler through the prelude's from_any_dir.py
# shim (which calls os.execl, not execlp). On non-Nix macOS/Linux the /usr/bin
# binaries work directly.
absolute_clang_tools(
    name = "clang-tools",
    visibility = ["PUBLIC"],
)

cxx_tools_info_toolchain(
    name = "cxx_system",
    cxx_tools_info = ":clang-tools",
    visibility = ["PUBLIC"],
)

# Canonical public cxx toolchain — toolchain_alias forwards is_toolchain_rule.
toolchain_alias(
    name = "cxx",
    actual = ":cxx_nix" if _use_nix else ":cxx_system",
    visibility = ["PUBLIC"],
)

# ── Rust ───────────────────────────────────────────────────────────────────
#
# NIX set (default): fenix nightly built as a Buck2 artifact via flake.package.
# The flake mirrors the devshell's fenix component list exactly, so rustc,
# rust-analyzer, and the build all agree. rustc/rustdoc come from one combined
# toolchain derivation (:rustc + :rustc[rustdoc]); clippy-driver from :clippy.
flake.package(
    name = "rustc",
    binary = "rustc",
    binaries = ["rustdoc"],
    path = "toolchains//nix:flake",
    target_compatible_with = _TARGET_MAPPING,
)

flake.package(
    name = "clippy",
    binary = "clippy-driver",
    package = "clippy",
    path = "toolchains//nix:flake",
    target_compatible_with = _TARGET_MAPPING,
)

# EDITION DIVERGENCE: the Nix set uses edition 2024 per the migration plan; the
# system set stays at 2021 (today's behavior) to avoid changing it under the
# escape hatch. rust_crate() in build/rust.bzl defaults each crate to edition
# 2024 already, so this toolchain default only affects targets that don't set one.
# OPT_LEVEL for cargo buildscripts (cc-rs, thiserror probes, …). cargo_buildscript.bzl
# only sets OPT_LEVEL when it finds a digit -Copt-level=N in toolchain rustc_flags;
# without it, every cc-using buildscript dies with "OPT_LEVEL not defined".
_RUSTC_FLAGS = ["-Copt-level=0"]

nix_rust_toolchain(
    name = "rust_nix",
    rustc = ":rustc",
    rustdoc = ":rustc[rustdoc]",
    clippy = ":clippy",
    default_edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

# SYSTEM set (escape hatch): rustc/rustdoc/clippy-driver invoked directly by
# Buck2 (not through the cc shim), so bare command names resolve via PATH. In
# the Nix devshell, fenix provides nightly rustc on PATH automatically.
system_rust_toolchain(
    name = "rust_system",
    default_edition = "2021",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

# Canonical public rust toolchain — toolchain_alias forwards is_toolchain_rule.
toolchain_alias(
    name = "rust",
    actual = ":rust_nix" if _use_nix else ":rust_system",
    visibility = ["PUBLIC"],
)

