load(":defs.bzl", "absolute_clang_tools")

# ── C/C++ ──────────────────────────────────────────────────────────────────
#
# Uses absolute paths so cc-rs build scripts can invoke the compiler through
# the prelude's from_any_dir.py shim (which calls os.execl, not execlp).
#
# Nix users: override clang/clangxx/ar with the Nix store paths by pointing
# at a nix flake.package() target once buck2.nix is added as an external cell:
#
#   load("@nix//flake.bzl", "flake")
#   flake.package(name = "clang", binary = "clang", path = "build/toolchains/nix")
#   absolute_clang_tools(
#       name = "clang-tools",
#       clang   = "$(location :clang)",  # resolves to Nix store path
#       clangxx = "$(location :clang++)",
#       ar      = "$(location :ar)",
#   )

absolute_clang_tools(
    name = "clang-tools",
    visibility = ["PUBLIC"],
)

cxx_tools_info_toolchain(
    name = "cxx",
    cxx_tools_info = ":clang-tools",
    visibility = ["PUBLIC"],
)

# ── Rust ───────────────────────────────────────────────────────────────────
#
# rustc/rustdoc/clippy-driver are invoked directly by Buck2 (not through the
# cc shim), so bare command names resolve correctly via the process PATH.
# In the Nix devshell, fenix provides the nightly rustc on PATH automatically.
#
# Nix users who want version-pinned rustc as a Buck2 artifact can switch to:
#   load("@nix//toolchains:rust.bzl", "nix_rust_toolchain")
#   nix_rust_toolchain(name = "rust", rustc = ":rustc", ...)

system_rust_toolchain(
    name = "rust",
    default_edition = "2021",
    visibility = ["PUBLIC"],
)

