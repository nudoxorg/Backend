# Loads the nonstandard flake location through nix-direnv.
# Watches every file that can alter the development environment.
# Leaves all behavioral commands to the pinned Nushell application.
direnv_layout_dir() {
  printf '%s\n' "$PWD/.local/direnv"
}

watch_file .config/flake.nix
watch_file .config/flake.lock
nix_direnv_disallow_fallback
watch_file .config/nix/*.nix
watch_file .config/nu/*.nu
watch_file .config/nu/*/*.nu
watch_file .config/tests/*.nu
watch_file .config/tests/*/*.nu
watch_file .config/tests/*/*/*.rs
watch_file .config/dylint/*.rs
watch_file .config/dylint/ui/*.rs
watch_file .config/dylint/ui/*.stderr
watch_file .config/rustfmt.toml
use flake path:.config#development
