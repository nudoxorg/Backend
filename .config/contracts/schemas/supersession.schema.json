{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend.control-plane.v1/Supersession",
  "x-backend-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["old_id", "new_id", "reason", "authority", "at"],
  "properties": {
    "old_id": { "type": "string", "minLength": 1 },
    "new_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "authority": { "enum": ["controller", "evaluator", "reviewer", "sol"] },
    "at": { "type": "integer", "minimum": 0 }
  }
}
