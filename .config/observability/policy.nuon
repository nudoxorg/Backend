# Defines bounded telemetry boundaries, labels, artifacts, and comparison facts.
# Separates local measurement production from baseline promotion privileges.
# Prevents source data and unbounded strings from entering operational telemetry.
{
  required_boundaries: ["external-request" "compiler-stage" "durable-transition" "runtime-admission" "index-query" "transport-retry" "cancellation"]
  prohibited_labels: ["source-text" "query-text" "filesystem-path" "content-id" "raw-error" "unbounded-string"]
  required_loss_counters: ["accepted" "dropped-full" "exported" "export-failed" "shutdown-flush-failed"]
  local_artifacts: ["run.json" "selection.json" "trace.jsonl" "cargo-timings.html" "profile.json" "measurement.json"]
  measurement_planes: ["wall" "instruction" "cache" "allocation" "rss" "span" "build" "binary"]
  comparison_facts: ["git-range" "dirty-fingerprint" "flake-lock" "host" "cpu" "toolchain" "features" "fixture" "dimensions"]
  privilege: {
    writers: []
    terra-academic: []
    terra-reviewer: ["benchmark" "profile" "baseline-read"]
    sol-integrator: ["benchmark" "profile" "baseline-read" "baseline-write"]
  }
}
