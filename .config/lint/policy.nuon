# Registers every lint with one engine, rationale, exception policy, and proof.
# Prevents duplicate enforcement and diagnostics without adversarial fixtures.
# Supplies the same machine-readable explanation to humans and generated skills.
[
  { id: "preserve-error-cause", engine: "ast-grep", severity: "error", exception: "none", proof: "valid-invalid-snapshot" }
  { id: "no-discarded-result", engine: "ast-grep", severity: "error", exception: "typed cleanup terminal only", proof: "valid-invalid-snapshot" }
  { id: "no-trivial-getter", engine: "ast-grep", severity: "warning", exception: "trait implementation or validated view", proof: "valid-invalid-snapshot" }
  { id: "no-trivial-setter", engine: "ast-grep", severity: "warning", exception: "validated state transition", proof: "valid-invalid-snapshot" }
  { id: "no-locking-primitives", engine: "ast-grep", severity: "error", exception: "foreign adapter quarantine with review", proof: "valid-invalid-snapshot" }
  { id: "no-dynamic-json", engine: "ast-grep", severity: "error", exception: "untrusted envelope quarantine", proof: "valid-invalid-snapshot" }
  { id: "no-public-primitive-field", engine: "ast-grep", severity: "warning", exception: "reviewed wire or FFI scalar", proof: "valid-invalid-snapshot" }
  { id: "no-single-letter-generics", engine: "ast-grep", severity: "error", exception: "none", proof: "valid-invalid-snapshot" }
  { id: "file-purpose", engine: "nushell", severity: "error", exception: "generated immutable snapshot", proof: "filesystem-fixture" }
  { id: "library-surface", engine: "nushell", severity: "error", exception: "none", proof: "filesystem-fixture" }
  { id: "flattened-crate", engine: "nushell", severity: "error", exception: "vendored source", proof: "filesystem-fixture" }
  { id: "named-module", engine: "nushell", severity: "error", exception: "none", proof: "filesystem-fixture" }
  { id: "semantic-scalar", engine: "dylint", severity: "error", exception: "reviewed wire or FFI scalar", proof: "ui-neighbor-snapshot" }
  { id: "hidden-mutability", engine: "dylint", severity: "error", exception: "proved atomic protocol", proof: "ui-neighbor-snapshot" }
  { id: "lifetime-escape", engine: "dylint", severity: "error", exception: "none", proof: "ui-neighbor-snapshot" }
  { id: "unsafe-share-contract", engine: "dylint", severity: "error", exception: "Loom and Miri proof", proof: "ui-neighbor-snapshot" }
]
