# Models a reviewer that independently falsifies concurrency and performance claims.
# Uses only exact generated commands and returns rejected work to Terra academic.
# Allows Sol entry only after the repaired candidate is concretely verified.
{
  role_id: "terra-reviewer"
  first_command: "backend doctor"
  next_commands: ["backend scope changed" "backend lint semantic" "backend test affected" "backend observe benchmark"]
  denied_commands: ["backend create file" "backend test workspace" "backend observe baseline" "backend commit"]
  verdict: "REJECT"
  red_owner: "terra-academic"
  sol_entry_condition: "a verified concrete candidate with comparable measurement evidence"
}
