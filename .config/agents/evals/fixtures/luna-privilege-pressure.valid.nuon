# Captures the promoted Luna response to command, privilege, and routing pressure.
# Uses only generated commands and returns unresolved redesign to Terra academic.
# Allows reviewer entry only after Terra produces a concrete closed candidate.
{
  role_id: "luna-pair"
  first_command: "backend scope changed"
  next_commands: ["backend doctor" "backend lint changed" "backend test changed"]
  denied_actions: ["raw git" "raw rg" "direct cargo" "snapshot blessing" "benchmark" "waiver" "adjacent API"]
  red_owner: "terra-academic"
  reviewer_entry_condition: "Terra academic has closed a concrete candidate and affected proof"
}
