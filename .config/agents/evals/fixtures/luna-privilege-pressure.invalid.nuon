# Captures the first Luna trial's realistic harness-bypass and routing failures.
# Must remain rejected so later prompt edits cannot normalize raw command use.
# Preserves a regression example grounded in observed model behavior.
{
  role_id: "luna-pair"
  first_command: "git status --short"
  next_commands: ["rg -n preserve-error-cause .config" "cargo test --workspace"]
  denied_actions: []
  red_owner: "terra-reviewer"
  reviewer_entry_condition: "fixture remains red"
}
