# Models the privilege and handoff mistakes found by the first reviewer trial.
# Incorrectly denies owned proof commands and returns repairs to an undefined author.
# Must remain rejected by the executable role grader.
{
  role_id: "terra-reviewer"
  first_command: "backend doctor"
  next_commands: ["backend scope changed" "backend observe benchmark"]
  denied_commands: ["backend lint semantic" "backend test affected"]
  verdict: "REJECT"
  red_owner: "author"
  sol_entry_condition: "once the author says the work is ready"
}
