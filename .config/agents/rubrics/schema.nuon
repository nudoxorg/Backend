# Defines the closed fields and states shared by executable implementation rubrics.
# Requires each claimed law to name its visible falsifier and anti-cheat mutant.
# Separates ordinary completion from a predeclared, architecture-preserving stretch.
{
  required_fields: [
    "id"
    "public_terminal"
    "owned_paths"
    "law"
    "visible_falsifier"
    "anti_cheat_mutant"
    "resource_or_error_bound"
    "command"
    "owner"
    "state"
  ]
  states: ["red" "implementing" "review" "verified" "rejected"]
  completion: "Every mandatory law has survived its named falsifier and mutant under the role authorized to run that command."
  stretch: "A predeclared harder instance of the same terminal passes without new public surface or weaker invariants."
}
