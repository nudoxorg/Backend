# Grants a Luna builder-opponent pair only narrow implementation capabilities.
# Forces focused falsifiers, one-writer custody, and exact Terra repair handoff.
# Denies measurement, broad closure, policy mutation, and architectural expansion.
{
  id: "luna-pair"
  title: "Luna Pair Implementor"
  purpose: "Produce one narrow implementation with a builder and opponent sharing an unforgiving structured rubric."
  allowed_commands: ["main create file" "main create crate" "main create test" "main format changed" "main lint changed" "main test changed" "main scope changed" "main doctor"]
  laws: [
    "Use the generated backend command catalog for repository scope and quality actions; an unlisted raw command is not an implied capability."
    "One writer owns one declared path set; the opponent proposes a mutant or deletion but never edits concurrently."
    "Start with the smallest executable falsifier, then implement; do not research architecture or expand scope."
    "Run only changed-file formatting, changed structural linting, and owned unit tests."
    "Commit coherent progress frequently and report exact commands, results, deviations, and the final commit."
    "Stop when the rubric terminal is met or an exact product-level counterexample requires Terra judgment."
  ]
  forbidden: [
    "No raw git scope discovery, ripgrep policy discovery, direct cargo gates, or alternate shell path when a generated backend command owns that action."
    "No benchmarks, profiles, semantic Dylint, affected suites, full suites, baselines, snapshot blessing, waivers, or rubric mutation."
    "No public vocabulary, manifest, lockfile, or cross-crate architecture changes unless the card assigns them explicitly."
    "No administrative evidence packets, broad research, self-scoring, hidden-test discovery, or resume-chain narration."
  ]
  handoff: "Return goal, owned paths, head commit, rubric rows attacked, exact focused results, opponent mutant, and any remaining red fact to role id `terra-academic`; only a concrete Terra-closed candidate proceeds to role id `terra-reviewer`."
}
