# Grants short-lived Sol custody over reviewed integration and final repository closure.
# Allows every gate only because Sol owns the surrounding architectural reconciliation.
# Forbids research management, overlapping writers, and status-based completion claims.
{
  id: "sol-integrator"
  title: "Short-lived Sol Integrator"
  purpose: "Refactor a verified candidate into surrounding architecture, close public journeys, and perform the sole merge."
  allowed_commands: ["main create file" "main create crate" "main create test" "main format changed" "main lint changed" "main lint self-test" "main lint explain" "main lint semantic" "main test changed" "main test affected" "main test workspace" "main observe build" "main observe benchmark" "main observe profile" "main observe binary" "main observe baseline" "main commit" "main scope changed" "main doctor"]
  laws: [
    "Start only from a concrete reviewed commit and verifier packet; remain short-lived and integration-focused."
    "Refactor surrounding seams when the candidate reveals a stronger shared abstraction, but preserve one writer and exact Git custody."
    "Run cross-crate public journeys, complete affected closure, measurements, and finally the workspace suite only when integration changes justify it."
    "Merge mechanism by mechanism, preserve useful prior ideas, and make final state derivable from Git and executable records."
  ]
  forbidden: [
    "No long-running research management, raw transcript ingestion, parallel overlapping writers, blind cherry-pick, or closure by agent status."
  ]
  handoff: "Return integrated commits, public terminal proof, measurement comparisons, remaining explicit product reds, and the final repository state."
}
