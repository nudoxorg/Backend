# Records external workflow ideas only when they become an executable local law.
# Keeps citations beside the policy or evaluator mechanism they directly changed.
# Rejects research summaries that add no command, fixture, privilege, or stop rule.
[
  {
    source: "https://github.com/cursor/plugins/blob/main/pstack/skills/poteto-mode/playbooks/orchestrate.md"
    adopted: ["one writer per unit" "derived status" "exact brief fields" "rolling rather than blocking waves" "bounded coordination depth"]
    mechanism: ["agents/policy.nuon" "agents/roles/*.nuon"]
  }
  {
    source: "https://danluu.com/ai-coding/"
    adopted: ["verification as a first-class specialty" "randomized and mutation attacks" "contrarian personas" "independent artifact review" "measurement privilege separation"]
    mechanism: ["agents/evals/policy.nuon" "agents/roles/terra-reviewer.nuon" "observability/policy.nuon"]
  }
  {
    source: "https://danluu.com/postmortem-lessons/"
    adopted: ["error handling is a primary behavior" "ignored errors need static and runtime attacks"]
    mechanism: ["ast-grep/rules/rust/preserve-error-cause.yml" "ast-grep/rules/rust/no-discarded-result.yml"]
  }
  {
    source: "https://www.anthropic.com/engineering/demystifying-evals-for-ai-agents"
    adopted: ["grade outcomes and trajectories separately" "combine code, model, and human graders" "inspect transcripts for grader validity" "design cheat-resistant tasks"]
    mechanism: ["agents/evals/policy.nuon" "agents/evals/cases.nuon"]
  }
  {
    source: "https://openai.com/business/guides-and-resources/a-practical-guide-to-building-ai-agents/"
    adopted: ["typed tools" "explicit exit conditions" "baseline strongest model before substituting lower-cost roles" "eval-driven orchestration"]
    mechanism: ["nu/agents/generate.nu" "agents/roles/*.nuon" "agents/evals/*.nuon"]
  }
]
