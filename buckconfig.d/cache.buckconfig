# Buck2 caching configuration.
#
# Loaded via a `<file:...>` include from the root .buckconfig (Buck2 does not
# auto-load a buckconfig.d/ directory — the include directive is the portable
# way to keep cache config in its own file).
#
# ── Reality check (verified against buck2.build docs + facebook/buck2 source/
#    issue tracker on buck2 2026-07-02, and `buck2 audit config <section>` run
#    against this repo) ─────────────────────────────────────────────────────
#
# Buck2 is NOT Buck1. Buck1's `[cache] mode = dir|http` local/HTTP action
# cache has NO equivalent in Buck2. Buck2 only caches action *results* via the
# Bazel Remote Execution/REAPI action-cache + CAS protocol (gRPC), configured
# under `[buck2_re_client]`. There is no plain-HTTP-cache mode. A Buck2
# maintainer confirmed this explicitly on facebook/buck2#459 ("Buck2 doesn't
# currently support the [Buck1] HTTP Cache API. Instead, it uses the Bazel
# Remote Execution and Caching APIs...") and that issue was closed wontfix.
#
# Consequently, `[cache] mode`, `dir_mode`, and `dir` (as previously set here)
# are Buck1-era keys that Buck2 does not read or act on at all — buckconfig
# parsing is permissive about unknown sections, so `buck2 audit config cache`
# happily echoes them back, but that only proves the *parser* tolerates the
# section, not that any subsystem consumes it. They were dead config. Removed.
#
# The closest thing Buck2 has to a local action cache is an IN-MEMORY,
# per-daemon-process cache of executed actions (see
# https://buck2.build/docs/users/advanced/in_memory_cache/) — it dies with
# `buck2 kill` / daemon restart and is not configurable via buckconfig at all.
# `buck2 clean` / a fresh daemon means a full rebuild of anything not backed
# by a real RE service. There is currently no supported way to get a
# persistent, disk-backed, cross-invocation action-result cache without
# standing up an RE-protocol-speaking service (e.g. BuildBarn, BuildBuddy) —
# see also open feature request facebook/buck2#976 ("Preserve local cache
# across daemon restarts"), which confirms this gap is known and unresolved
# upstream, not a config mistake on our end.
#
# ── What IS real and effective here ──────────────────────────────────────
# `[buck2] materializations` and `sqlite_materializer_state` (below) are real,
# consumed keys — but they are materializer bookkeeping, not an action cache:
#   - `materializations = deferred` controls WHEN Buck2 downloads action
#     *outputs* from RE into buck-out (deferred = only when locally needed,
#     vs `immediate` = as soon as the action finishes on RE). This has no
#     effect on whether the action itself re-runs.
#   - `sqlite_materializer_state = true` persists "what's already correctly
#     materialized in buck-out" across daemon restarts, so Buck2 can avoid
#     RE-DOWNLOADING outputs it already has on disk. Per the official docs
#     (buck2.build/docs/users/advanced/deferred_materialization/), this is
#     explicitly scoped to avoiding re-download *from RE* — with no RE
#     service configured (our case), there is nothing for it to avoid
#     re-downloading from, so today this key is inert in practice. It is left
#     enabled (harmless, real key, and becomes useful the moment RE is added)
#     rather than removed.
#
# ── Cross-machine reuse, today ───────────────────────────────────────────
# Achieved indirectly, not via Buck2 action caching: every input to a Buck2
# action (rustc, clippy, cc/cxx) is a pinned Nix store path whose closure is
# shared across machines through the Attic binary cache. Identical toolchain
# closures + identical sources => identical build inputs on every host, even
# though Buck2 itself still re-runs each action locally on each machine/clean.
#
# ── Future: real cross-invocation + cross-machine action-result caching ──
# Requires a real REAPI action-cache/CAS backend (BuildBarn, BuildBuddy, or
# similar) — plain HTTP blob storage is NOT sufficient, Buck2 speaks the
# Bazel Remote Execution gRPC protocol, not a simple HTTP GET/PUT cache. When
# that's stood up, the effective keys (verified against
# buck2.build/docs/users/remote_execution/) are:
#
# [buck2_re_client]
#     engine_address = grpc://re.example.internal:PORT
#     action_cache_address = grpc://re.example.internal:PORT
#     cas_address = grpc://re.example.internal:PORT
#     instance_name = main
#     tls_ca_certs = /path/to/ca.pem
#     # tls_client_cert = /path/to/client.pem
#     # http_headers = "Authorization:Bearer ..."
#     # local_enabled = true   # hybrid local+RE execution

[buck2]
    # Only affects behavior once/if an RE backend exists (see above) — with
    # no RE configured, `deferred` vs `immediate` is moot and
    # sqlite_materializer_state has nothing to avoid re-downloading. Left
    # set to the safer/cheaper default rather than removed.
    materializations = deferred
    sqlite_materializer_state = true
