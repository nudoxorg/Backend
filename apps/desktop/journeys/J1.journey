# J1 · first look (gui-plan §3 item 10), on a real install of toml_pin.
# launch → Orbit → your project → one of its own items → its code (⌘.) →
# back ×2 → the dependency toml 0.8.23's page → from_str → its code → back.
# Expected words are read from the sources: toml_pin's Cargo.toml and
# src/lib.rs; toml 0.8.23's src/de.rs:41 in the local cargo cache.
# gui-plan's "Start here" tour was removed from the package page on purpose
# (W-Folio: no fixture-ranked tour), so stop 1 is reached through the page's
# own outline instead.
size 1440x900
start from install frontends/rust/fixtures/toml_pin

check orbit
  route like "orbit"
  text "toml_pin" in reader

click "toml_pin" in reader
check your-project
  route like "package *toml_pin"
  text "toml-pin-fixture" in reader
  budget page-open <= 120ms

click "read_settings" in reader
check your-item
  route like "symbol *read_settings view=page*"
  text "read_settings" in reader
  budget page-open <= 120ms

key cmd-.
check your-item-code
  route like "symbol *read_settings view=code*"
  line "pub fn read_settings(text: &str) -> Result<Settings, toml::de::Error> {" in reader

key cmd-[
check back-to-your-project
  route like "package *toml_pin"
  focus restored

needs product "toml 0.8.23, the crate toml_pin pins, is indexed and its dependency row is a link (GAPS.md G15)"
click "toml" in reader
check package
  route like "package *toml*0.8.23*"
  text "toml" in reader
  line "0.8.23" in reader
  budget page-open <= 120ms

click "from_str" in reader
check stop-1
  route like "symbol *from_str view=page*"
  text "from_str" in reader
  budget page-open <= 120ms

key cmd-.
check code
  route like "symbol *from_str view=code*"
  line "pub fn from_str<T>(s: &'_ str) -> Result<T, Error>" in reader

key cmd-[
check back-1
  route like "package *toml*0.8.23*"
  focus restored

key cmd-[
check back-2
  route like "package *toml_pin"
  focus restored

key cmd-[
check back-3
  route like "orbit"
  focus restored
  budget frame-p95 <= 8ms
