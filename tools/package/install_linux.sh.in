#!/bin/sh
# Nudox for Linux (x86_64).
#   curl -fsSL https://github.com/nudoxorg/releases/releases/download/@TAG@/install-linux.sh | sh
#   sh install-linux.sh --uninstall
#
# release_contract.py renders this per release: the tag, archive and SHA-256
# are pinned, so the script only ever installs the bytes it was published with.
set -eu

TAG="@TAG@"
ARCHIVE="@ARCHIVE@"
SHA256="@SHA256@"
MINIMUM_GLIBC="@MINIMUM_GLIBC@"
# Release QA serves the candidate archive locally; the checksum still binds it.
URL="${NUDOX_INSTALL_ARCHIVE_URL:-https://github.com/nudoxorg/releases/releases/download/$TAG/$ARCHIVE}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
PREFIX="$DATA/nudox/$TAG"
BIN="$HOME/.local/bin"
COMMANDS="nudox nudox-desktop nudox-mcp"

say() { printf '%s\n' "$*"; }
die() { printf 'nudox install: %s\n' "$*" >&2; exit 1; }

if [ "${1:-}" = "--uninstall" ]; then
  for name in $COMMANDS; do
    if [ -L "$BIN/$name" ]; then rm -f "$BIN/$name"; fi
  done
  rm -f "$DATA/applications/nudox.desktop"
  # Only what an install wrote: versioned trees and the current link.
  rm -f "$DATA/nudox/current"
  for tree in "$DATA"/nudox/v[0-9]*; do
    if [ -d "$tree" ]; then rm -rf "$tree"; fi
  done
  rmdir "$DATA/nudox" 2>/dev/null || true
  say "Nudox is uninstalled. Your projects and sign-in are kept."
  exit 0
fi
[ $# -eq 0 ] || die "usage: install-linux.sh [--uninstall]"

[ "$(uname -s)" = Linux ] || die "this installer is for Linux"
case "$(uname -m)" in
  x86_64|amd64) ;;
  *) die "this release has no build for $(uname -m); see https://nudox.org/quickstart" ;;
esac
glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
[ -n "$glibc" ] || die "glibc not found (musl distributions are not supported yet)"
major=${glibc%%.*}; minor=${glibc#*.}; minor=${minor%%.*}
need_major=${MINIMUM_GLIBC%%.*}; need_minor=${MINIMUM_GLIBC#*.}
if [ "$major" -lt "$need_major" ] || { [ "$major" -eq "$need_major" ] && [ "$minor" -lt "$need_minor" ]; }; then
  die "needs glibc $MINIMUM_GLIBC or newer; this system has $glibc"
fi
command -v curl >/dev/null || die "curl is required"
command -v tar >/dev/null || die "tar is required"
if command -v sha256sum >/dev/null; then check() { sha256sum "$1" | awk '{print $1}'; }
else check() { shasum -a 256 "$1" | awk '{print $1}'; }; fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
say "Downloading Nudox ($TAG)…"
curl -fL --progress-bar -o "$work/$ARCHIVE" "$URL"
[ "$(check "$work/$ARCHIVE")" = "$SHA256" ] || die "download checksum mismatch; try again"

rm -rf "$PREFIX.partial"
mkdir -p "$PREFIX.partial"
tar -xzf "$work/$ARCHIVE" -C "$PREFIX.partial" --strip-components=1
rm -rf "$PREFIX"
mv "$PREFIX.partial" "$PREFIX"
ln -sfn "$PREFIX" "$DATA/nudox/current"

mkdir -p "$BIN"
for name in $COMMANDS; do
  ln -sfn "$DATA/nudox/current/bin/$name" "$BIN/$name"
done

apps="$DATA/applications"
mkdir -p "$apps"
cat > "$apps/nudox.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Nudox
Comment=Nudox
Exec=$BIN/nudox-desktop
Terminal=false
Categories=Development;
EOF

say ""
say "Nudox is installed."
say ""
say "  1. Get an API key:  https://nudox.org/dashboard/keys"
say "  2. Start the app:   nudox-desktop    (it asks for the key once)"
say "     or in a shell:   nudox auth login"
say ""
say "  MCP (Claude Code):  claude mcp add nudox -- $BIN/nudox-mcp --project \"\$PWD\""
say "  MCP (Codex):        codex mcp add nudox -- $BIN/nudox-mcp --project \"\$PWD\""
case ":$PATH:" in *":$BIN:"*) ;; *) say ""; say "  Add $BIN to your PATH to use these commands.";; esac
