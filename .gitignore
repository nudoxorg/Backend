# Ignore everything by default
/**/*

# Allow all directories for traversal
!**/

# Deny common build/cache directories
**/.DS_Store
**/target/
**/.cache/
**/.git/

# Deny Nix symlinks and generated files
**/result
**/result-*

# Deny temporary/log files
**/*.log

# Root level files
!/.gitignore
!/README.md
!/LICENSE
!/justfile
!/default.nix
!/here
!/.envrc
!/.editorconfig

# Rust / Cargo
!/**/Cargo.toml
!/**/Cargo.lock
!/**/*.rs
!/**/rustfmt.toml

# Nix
!/flake.nix
!/flake.lock

# Data and Configuration Artifacts
# TODO: Remove from pipeline (currently used for debugging/regression tracking)
!/**/example.json
!/**/out.json
!/**/docs.json
!/**/schema.json

# Documentation
!/**/*.md

# Allow empty .keep files
!/**/.keep
!/.config/scripts/*.nu

## Cue
!/.config/**/*.cue

/.direnv
!/schema.yaml

# Devenv
!/devenv.yaml
!/devenv.nix
!/devenv.lock

# TODO: Remove when upstreamed
!/linkml

!/deno_doc/**/*


.claude/worktrees/
