# Ignore everything by default
/**/*

# Allow all directories for traversal
!**/

# Deny common build/cache directories
**/.DS_Store
**/target/
**/.cache/
**/.git/
# Buck2 persistent on-disk sqlite dir-cache (buckconfig.d/cache.buckconfig dir = .buck-cache/sqlite).
# Lives outside buck-out intentionally to survive `buck2 clean`; must be gitignored.
**/.buck-cache/

# Deny Nix symlinks and generated files
**/result
**/result-*

# Deny temporary/log files
**/*.log

# Root level files
!/.gitignore
!/README.md
!/LICENSE
!/justfile
!/default.nix
!/here
!/.envrc
!/.editorconfig

# Rust
!/**/*.rs
!/**/rustfmt.toml

# Nix
!/flake.nix
!/flake.lock
# CI-maintained pin recording the Attic store path of the buck2/snowydeer
# artifact that packages.default fetchClosure's (see flake.nix). Must be tracked
# so it's part of the flake source snapshot.
!/nix/buck2-artifact.json

# Data and Configuration Artifacts
# TODO: Remove from pipeline (currently used for debugging/regression tracking)
!/**/example.json
!/**/out.json
!/**/docs.json
!/**/schema.json

# Documentation
!/**/*.md

# Producer test fixtures: source files for the TypeScript / Nix producers are
# committed (mirroring the committed Rust `.rs` fixtures). Manifests that tests
# scaffold at runtime (rust `Cargo.toml`) stay ignored; these are the inputs the
# producers read directly, so they must live in the tree.
!/workspace/compiler/tests/fixtures/**/*.ts
!/workspace/compiler/tests/fixtures/**/*.tsx
!/workspace/compiler/tests/fixtures/**/*.mts
!/workspace/compiler/tests/fixtures/**/*.cts
!/workspace/compiler/tests/fixtures/**/*.d.ts
!/workspace/compiler/tests/fixtures/**/package.json
!/workspace/compiler/tests/fixtures/**/*.nix

# Patch files for Buck2 genrules
!/**/*.patch

# Allow empty .keep files
!/**/.keep
!/.config/scripts/*.nu
!/.vscode/settings.json

## Cue
!/.config/**/*.cue

/.direnv
!/schema.yaml

# Devenv
!/devenv.yaml
!/devenv.nix
!/devenv.lock

# TODO: Remove when upstreamed
!/linkml

!/deno_doc/**/*

# Buck2 build system
!/.buckconfig
!/.buckroot
!/.buckversion
# Cache config pulled in by .buckconfig via `<file:buckconfig.d/cache.buckconfig>`.
# The include is mandatory, so this MUST be tracked or fresh checkouts / CI fail
# to start the daemon. (The on-disk cache dir itself, .buck-cache/, stays ignored.)
!/buckconfig.d/
!/buckconfig.d/**
!/build/
!/build/**
!**/BUCK
!**/TARGETS
/buck-out/
/.buckconfig.local
/.buckcredentials
/rust-project.json
/prelude

.claude/worktrees/
/build/prelude
/build/third-party/tools
/build/third-party/vendor

# Writable Buck2 prelude (generated by build/setup-prelude.sh)
/build/prelude-local/

# snowydeer deploy boundary (Phase 4) — vendored Buck2 + Python files
!/snowydeer/
!/snowydeer/**
# link_style constraints for snowydeer transition_to_static
!/constraints/
!/constraints/**
/.agent-wt
