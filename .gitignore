# Ignore everything by default
/**/*

# Allow all directories for traversal
!**/

# Deny common build/cache directories
**/.DS_Store
**/target/
**/.cache/
**/.git/

# Deny Nix symlinks and generated files
**/result{,-*}

# Deny temporary/log files
**/*.log

# Root level files
!/{.gitignore,README.md,LICENSE,justfile,default.nix,here,.envrc,.editorconfig}

# Rust / Cargo
!/**/Cargo.{toml,lock}
!/**/*.rs
!/**/rustfmt.toml

# Nix
!/flake.{nix,lock}

# Data and Configuration Artifacts
# TODO: Remove from pipeline (currently used for debugging/regression tracking)
!/**/{example,out,docs,schema}.json

# Documentation
!/**/*.md

# Allow empty .keep files
!/**/.keep
!/.config/scripts/*.nu

## Cue
!/.config/**/*.cue

