{"query":"Session","coverage":[{"lane":"exact","state":"complete"},{"lane":"names","state":"complete"},{"lane":"graph","state":"complete"},{"lane":"semantic","state":"unavailable","reason":"unconfigured"}],"readiness":"ready","records":[{"identity":{"coordinate":"/Users/rmccrar6/nudox-functional-corpus-20261006/sol-fresh-remote-runtime/runs/sol61-private-store-trace-f6eee1512c/20261006T200321Z-python-stock-host-8715e27b/project::semantic::8e36914e06891f98b9950895e79f2e55f7824d986f6f5e7c4b15ce62263f6e52::Session","trail":"project › src/requests/sessions.py:395 › Session","name":"Session","shape":"semantic","project":"/Users/rmccrar6/nudox-functional-corpus-20261006/sol-fresh-remote-runtime/runs/sol61-private-store-trace-f6eee1512c/20261006T200321Z-python-stock-host-8715e27b/project","path":"src/requests/sessions.py","line":395,"segments":["Session"],"key":"5bbb215c","semantic_data":{"kind":"selected-symbol-id","value":[91,187,33,92,81,241,37,2,49,146,215,121,250,190,44,160,101,44,60,221,213,233,197,162,180,123,0,106,194,5,42,31]}},"kind":"struct","language":"python","state":"ready","signature":"class Session(SessionRedirectMixin):\n    \"\"\"A Requests session.\n\n    Provides cookie persistence, connection-pooling, and configuration.\n\n    Basic Usage::\n\n      >>> import requests\n      >>> s = requests.Session()\n      >>> s.get('https://httpbin.org/get')\n      <Response [200]>\n\n    Or as a context manager::\n\n      >>> with requests.Session() as s:\n      ...     s.get('https://httpbin.org/get')\n      <Response [200]>\n    \"\"\"\n\n    headers: CaseInsensitiveDict[str]\n    auth: _t.AuthType\n    proxies: dict[str, str]\n    hooks: dict[str, list[_t.HookType]]\n    params: MutableMapping[str, Any]\n    stream: bool\n    verify: _t.VerifyType\n    cert: _t.CertType\n    max_redirects: int\n    trust_env: bool\n    cookies: RequestsCookieJar\n    adapters: MutableMapping[str, BaseAdapter]\n\n    __attrs__: list[str] = [\n        \"headers\",\n        \"cookies\",\n        \"auth\",\n        \"proxies\",\n        \"hooks\",\n        \"params\",\n        \"verify\",\n        \"cert\",\n        \"adapters\",\n        \"stream\",\n        \"trust_env\",\n        \"max_redirects\",\n    ]\n\n    def __init__(self) -> None:\n        #: A case-insensitive dictionary of headers to be sent on each\n        #: :class:`Request <Request>` sent from this\n        #: :class:`Session <Session>`.\n        self.headers = default_headers()\n\n        #: Default Authentication tuple or object to attach to\n        #: :class:`Request <Request>`.\n        self.auth = None\n\n        #: Dictionary mapping protocol or protocol and host to the URL of the proxy\n        #: (e.g.","summary":"A Requests session.","score":4294967295},{"identity":{"coordinate":"/Users/rmccrar6/nudox-functional-corpus-20261006/sol-fresh-remote-runtime/runs/sol61-private-store-trace-f6eee1512c/20261006T200321Z-python-stock-host-8715e27b/project::semantic::cf0b10e9c5f3fa8a5ef40958b61d0b7ebbe7337e4604d721bd0111936792f904::Session","trail":"project › Session","name":"Session","shape":"semantic","project":"/Users/rmccrar6/nudox-functional-corpus-20261006/sol-fresh-remote-runtime/runs/sol61-private-store-trace-f6eee1512c/20261006T200321Z-python-stock-host-8715e27b/project","segments":["Session"],"key":"520a968c","semantic_data":{"kind":"selected-symbol-id","value":[82,10,150,140,68,151,64,99,96,105,171,124,202,228,101,161,68,217,129,148,84,242,31,16,37,78,237,78,86,248,54,211]}},"kind":"type","language":"unknown","state":"ready","signature":"unknown(unannotated)","score":4294967294},{"identity":{"coordinate":"/Users/rmccrar6/nudox-functional-corpus-20261006/sol-fresh-remote-runtime/runs/sol61-private-store-trace-f6eee1512c/20261006T200321Z-python-stock-host-8715e27b/project::semantic::9bad18504645d7d0abc0834c6c8769075568b123e994613d8921302d97597668::session","trail":"project › session","name":"session","shape":"semantic","project":"/Users/rmccrar6/nudox-functional-corpu