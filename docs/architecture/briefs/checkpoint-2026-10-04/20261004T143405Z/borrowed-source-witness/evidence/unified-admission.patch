+        let changed_reason_witness = CheckedPackageGraphSourceWitness::admit(
+            &purl_key,
+            BorrowedPackageGraphSourceState::Unknown(&changed_reason),
+        )
+        .expect("changed reason");
+        let known_empty = CheckedPackageGraphSourceWitness::admit(
+            &purl_key,
