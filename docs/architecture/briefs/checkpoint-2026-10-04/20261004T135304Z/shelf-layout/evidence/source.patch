+impl RowLayout {
+    fn new() -> Self {
+        let scroll = ListState::new(0, ListAlignment::Top, px(80.0))
+            .with_uniform_item_height(px(32.0));
+        let intent = Rc::new(Cell::new(Some(1_u64)));
+        let input_intent = Rc::clone(&intent);
