+    impl gpui::Render for MeasuredRows {
+        fn render(&mut self, _: &mut gpui::Window, _: &mut gpui::Context<Self>) -> impl gpui::IntoElement {
+            use gpui::{IntoElement as _, Styled as _, div, list};
+            let ordinary = self.ordinary;
