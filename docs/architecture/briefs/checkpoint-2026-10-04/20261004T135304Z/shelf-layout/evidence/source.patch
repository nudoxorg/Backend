+            rows: Rc::new(Vec::new()),
+            identities: Rc::new(Vec::new()),
+            scroll,
+            width: px(0.0),
+            scale: 1.0,
+            row_height: px(32.0),
+            restore: Restore::Idle,
+            reveal: None,
+            focused_in_list: None,
+            intent,
