+#[turso_macros::test(mvcc, init_sql = "CREATE TABLE t (a INTEGER, b TEXT);")]
+fn test_vacuum_into_decodes_apostrophe_in_destination_path(
+    tmp_db: TempDatabase,
+) -> anyhow::Result<()> {
+    let conn = tmp_db.connect_limbo();
+    conn.execute("INSERT INTO t VALUES (1, 'preserved')")?;
+
+    let dest_dir = TempDir::new()?;
+    let dest_path = dest_dir.path().join("vacuum'snapshot.db");
+    let sql_path = dest_path.to_str().unwrap().replace('\'', "''");
+    conn.execute(format!("VACUUM INTO '{sql_path}'"))?;
+
+    assert!(
+        dest_path.is_file(),
+        "the exact decoded path should be created"
+    );
+    let overescaped_path = dest_dir.path().join("vacuum''snapshot.db");
+    assert!(
+        !overescaped_path.exists(),
+        "the doubled SQL escape must not remain in the filename"
+    );
+
+    let dest_db = TempDatabase::builder()
+        .with_db_path(&dest_path)
+        .with_opts(tmp_db.db_opts)
+        .with_flags(turso_core::OpenFlags::default() | turso_core::OpenFlags::ReadOnly)
+        .build();
+    let dest_conn = dest_db.connect_limbo();
+    assert_eq!(run_integrity_check(&dest_conn), "ok");
+    let rows: Vec<(i64, String)> = dest_conn.exec_rows("SELECT a, b FROM t ORDER BY a");
+    assert_eq!(rows, vec![(1, "preserved".to_string())]);
+    assert!(matches!(
+        dest_conn.execute("INSERT INTO t VALUES (2, 'read only')"),
+        Err(LimboError::ReadOnly)
+    ));
+    Ok(())
+}
