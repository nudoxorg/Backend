+#[test]
+fn unpaged_graph_reader_rejects_edge_id_separate_from_typed_fact_identity() {
+    futures_executor::block_on(async {
+        let path = path();
+        let source = PackageReference::from_kind(
+            PackageReferenceKind::Local,
+            "pkg:cargo/edge-id-check@1.0.0",
+        )
+        .expect("same-spelling Local source");
+        let key = PackageGraphSourceKey::unattributed(source.clone());
+        let facts = [(
+            key.clone(),
+            DependencyFacts::Known(
+                vec![dependency_edge(&source, "edge-id-target", "^1")].into_boxed_slice(),
+            ),
+        )];
+        let projection = open_test(&path).await.expect("open");
+        projection
+            .synchronize_package_graph_current_for_test(fallback_seed_view().root(), &facts)
+            .await
+            .expect("persist typed Local edge");
+        let mut edge_rows = projection
+            .connection
+            .query(
+                "SELECT edge_id FROM backend_projection_package_edges WHERE source=?1 \
+                 AND coordinate_kind=?2",
+                turso::params![
+                    source.as_str(),
+                    i64::from(PackageReferenceKind::Local.tag())
+                ],
+            )
+            .await
+            .expect("persisted typed edge ID");
+        let original_id: [u8; 32] = edge_rows
+            .next()
+            .await
+            .expect("edge ID row")
+            .expect("one edge")
+            .get::<Vec<u8>>(0)
+            .expect("edge ID bytes")
+            .try_into()
+            .expect("32-byte edge ID");
+        let mut corrupted_id = original_id;
+        corrupted_id[0] ^= 1;
+        drop(edge_rows);
+        projection
+            .connection
+            .execute(
+                "UPDATE backend_projection_package_edges SET edge_id=?1 WHERE edge_id=?2",
+                turso::params![corrupted_id.as_slice(), original_id.as_slice()],
+            )
+            .await
+            .expect("corrupt only the row key");
+        assert!(projection
+            .package_dependencies_for_source(&key)
+            .await
+            .is_err(), "the unpaged decoder must match row key, typed payload, and witness");
+        drop(projection);
+        remove_database(&path);
+    });
+}
