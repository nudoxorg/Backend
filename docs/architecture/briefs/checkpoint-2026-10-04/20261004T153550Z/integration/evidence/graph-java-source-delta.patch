+#[test]
+fn both_graph_read_surfaces_reject_noncanonical_or_inconsistent_edge_rows() {
+    futures_executor::block_on(async {
+        let source = PackageReference::parse("pkg:cargo/strict-edge-source@1.0.0")
+            .expect("source coordinate");
+        let authority = PackageGraphSourceAuthority::Registry(
+            RegistryAuthorityId::from_configured_source([0x56; 32]),
+        );
+        let source_key = PackageGraphSourceKey::new(source.clone(), authority);
+        let target = PackageDependencyTarget::new(RegistryEcosystem::Cargo, "serde", "^1", None)
+            .expect("target");
+        let evidence = DependencyEvidence {
+            authority: DependencyAuthority::RegistryMetadata,
+            frontier: [0x57; 32],
+            provenance: [0x58; 32],
+        };
+        let edge = PackageDependencyRecord::new_with_source_authority(
+            source.clone(),
+            authority,
+            target.clone(),
+            DependencyScope::Runtime,
+            true,
+            evidence,
+        );
+        let mismatched_evidence_edge = PackageDependencyRecord::new_with_source_authority(
+            source.clone(),
+            authority,
+            target,
+            DependencyScope::Runtime,
+            true,
+            DependencyEvidence {
+                authority: DependencyAuthority::ArchiveManifest,
+                ..evidence
+            },
+        );
+        assert_ne!(
+            edge.facts_version,
+            mismatched_evidence_edge.facts_version,
+            "the corrupted row will carry a digest matching its changed evidence field"
+        );
+        let cases = [
+            ("optional=2", "optional must be exactly zero or one"),
+            ("target_name=' serde '", "target name must be exact text"),
+            ("requirement=' ^1 '", "requirement must be exact text"),
+            ("evidence", "evidence must match its source authority"),
+            ("resolved='not-a-purl'", "resolution must be an exact PURL"),
+            (
+                "edge_id=zeroblob(32), facts_version=zeroblob(32)",
+                "equal stored digests must still match the recomputed payload",
+            ),
+        ];
+        for (assignment, message) in cases {
+            let path = path();
+            let mut projection = open_test(&path).await.expect("open");
+            let facts = [(
+                source_key.clone(),
+                DependencyFacts::Known(vec![edge.clone()].into_boxed_slice()),
+            )];
+            projection
+                .synchronize_package_graph_current_for_test(fallback_seed_view().root(), &facts)
+                .await
+                .expect("persist valid row before corruption");
+            if assignment == "evidence" {
+                projection
+                    .connection
+                    .execute(
+                        "UPDATE backend_projection_package_edges SET authority=1, edge_id=?1, \
+                         facts_version=?2 WHERE edge_id=?3",
+                        turso::params![
+                            mismatched_evidence_edge.facts_version.as_slice(),
+                            mismatched_evidence_edge.facts_version.as_slice(),
+                            edge.facts_version.as_slice()
+                        ],
+                    )
+                    .await
+                    .unwrap_or_else(|error| panic!("{message}: {error}"));
+            } else {
+                let sql = format!(
+                    "UPDATE backend_projection_package_edges SET {assignment} WHERE edge_id=?1"
+                );
+                projection
+                    .connection
+                    .execute(&sql, turso::params![edge.facts_version.as_slice()])
+                    .await
+                    .unwrap_or_else(|error| panic!("{message}: {error}"));
+            }
+
+            assert!(
+                projection
+                    .package_dependencies_for_source(&source_key)
+                    .await
+                    .is_err(),
+                "unpaged read accepted corrupt row: {message}"
+            );
+            let request = backend_library::PackageGraphPageRequest::new(
+                source.clone(),
+                backend_library::PackageGraphDirection::Dependencies,
+                Some(authority),
+                4,
+            )
+            .expect("exact page request");
+            assert!(matches!(
+                projection.read_package_graph_page(&request).await,
+                Err(PackageGraphReadError::Projection(_))
+            ), "paged read accepted corrupt row: {message}");
+            drop(projection);
+            remove_database(&path);
+        }
+    });
+}
