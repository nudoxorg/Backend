+#[test]
+fn package_graph_persists_purl_and_local_same_text_as_distinct_typed_sources() {
+    futures_executor::block_on(async {
+        let path = path();
+        let spelling = "pkg:cargo/widget@1.0.0";
+        let purl = PackageReference::from_kind(PackageReferenceKind::Purl, spelling)
+            .expect("explicit PURL kind");
+        let local = PackageReference::from_kind(PackageReferenceKind::Local, spelling)
+            .expect("explicit Local kind");
+        assert_eq!(purl.as_str(), local.as_str());
+        assert_ne!(purl, local);
+
+        let purl_key = PackageGraphSourceKey::unattributed(purl.clone());
+        let local_key = PackageGraphSourceKey::unattributed(local.clone());
+        let purl_edge = dependency_edge(&purl, "shared-dependency", "^1");
+        let initial = vec![
+            (
+                local_key.clone(),
+                DependencyFacts::Unknown(ProductText::new("local source omitted facts")
+                    .expect("local reason")),
+            ),
+            (
+                purl_key.clone(),
+                DependencyFacts::Known(vec![purl_edge.clone()].into_boxed_slice()),
+            ),
+        ];
+        let checked_initial = CheckedPackageGraphFacts::new(initial).expect("typed facts");
+        assert_eq!(
+            checked_initial
+                .facts()
+                .iter()
+                .map(|(key, _)| key.coordinate.kind().tag())
+                .collect::<Vec<_>>(),
+            [PackageReferenceKind::Purl.tag(), PackageReferenceKind::Local.tag()]
+        );
+
+        let root = fallback_seed_view().root();
+        let mut projection = open_test(&path).await.expect("open");
+        projection
+            .synchronize_checked_package_graph_current_for_test(root.clone(), &checked_initial)
+            .await
+            .expect("persist both typed coordinates");
+        assert_typed_collision_results(&projection, &purl_key, &local_key, &purl_edge).await;
+        assert_coordinate_kind_rows(&projection, spelling, &[1], &[(2, 1)]).await;
+        drop(projection);
+
+        // Reopen the selected file before checking the distinct keys and states;
+        // this proves the kind is durable instead of merely resident in memory.
+        let mut projection = TursoProjection::open(&path).await.expect("cold reopen");
+        assert_typed_collision_results(&projection, &purl_key, &local_key, &purl_edge).await;
+
+        // Updating only Local from Unknown to Known must leave the same-spelling
+        // PURL edge untouched. This exercises delta reconciliation and each
+        // source/state/witness/edge key path with the kind tag included.
+        // The two records are equal except for their typed source coordinate,
+        // so their durable edge identities must remain distinct by that tag.
+        let local_edge = dependency_edge(&local, "shared-dependency", "^1");
+        let after = vec![
+            (
+                local_key.clone(),
+                DependencyFacts::Known(vec![local_edge.clone()].into_boxed_slice()),
+            ),
+            (
+                purl_key.clone(),
+                DependencyFacts::Known(vec![purl_edge.clone()].into_boxed_slice()),
+            ),
+        ];
+        let checked_after = CheckedPackageGraphFacts::new(after).expect("updated typed facts");
+        projection
+            .synchronize_checked_package_graph_current_for_test(root, &checked_after)
+            .await
+            .expect("update Local key only");
+        assert_eq!(
+            projection
+                .package_dependencies_for_source(&purl_key)
+                .await
+                .expect("exact PURL after update")
+                .edges
+                .as_ref(),
+            [purl_edge.clone()]
+        );
+        assert_eq!(
+            projection
+                .package_dependencies_for_source(&local_key)
+                .await
+                .expect("exact Local after update")
+                .edges
+                .as_ref(),
+            [local_edge.clone()]
+        );
+        let reverse_target = PackageReference::parse("pkg:cargo/shared-dependency@1.0.0")
+            .expect("reverse target PURL");
+        let reverse = projection
+            .package_dependents(&reverse_target)
+            .await
+            .expect("reverse lookup retains both typed source identities");
+        let mut reverse_sources = reverse
+            .edges
+            .iter()
+            .map(|edge| edge.source.clone())
+            .collect::<Vec<_>>();
+        reverse_sources.sort_unstable();
+        assert_eq!(reverse_sources, [purl.clone(), local.clone()]);
+        assert_coordinate_kind_rows(&projection, spelling, &[1, 2], &[]).await;
+        drop(projection);
+
+        let reopened = TursoProjection::open(&path).await.expect("reopen updated graph");
+        assert_eq!(
+            reopened
+                .package_dependencies_for_source(&purl_key)
+                .await
+                .expect("cold PURL").edges.as_ref(),
+            [purl_edge]
+        );
+        assert_eq!(
+            reopened
+                .package_dependencies_for_source(&local_key)
+                .await
+                .expect("cold Local").edges.as_ref(),
+            [local_edge]
+        );
+        drop(reopened);
+        remove_database(&path);
+    });
+}
