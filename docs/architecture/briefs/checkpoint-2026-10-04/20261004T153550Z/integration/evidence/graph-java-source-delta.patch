+        let purl = PackageReference::from_kind(PackageReferenceKind::Purl, spelling)
+            .expect("PURL coordinate");
+        let local = PackageReference::from_kind(PackageReferenceKind::Local, spelling)
+            .expect("Local coordinate");
+        let projection = open_test(&both_kinds_path).await.expect("open both-kinds DB");
+        insert_source_inventory_rows(
+            &projection,
+            spelling,
+            PackageReferenceKind::Purl,
+            MAX_PACKAGE_GRAPH_AUTHORITIES,
+        )
+        .await;
+        insert_source_inventory_rows(
+            &projection,
+            spelling,
+            PackageReferenceKind::Local,
+            MAX_PACKAGE_GRAPH_AUTHORITIES,
+        )
+        .await;
+        let purl_keys = graph::package_source_inventory(&projection.connection, &purl)
+            .await
+            .expect("64 PURL authorities");
+        let local_keys = graph::package_source_inventory(&projection.connection, &local)
+            .await
+            .expect("64 Local authorities with identical spelling");
+        assert_eq!(purl_keys.len(), MAX_PACKAGE_GRAPH_AUTHORITIES);
+        assert_eq!(local_keys.len(), MAX_PACKAGE_GRAPH_AUTHORITIES);
+        assert!(purl_keys
+            .iter()
+            .all(|key| key.coordinate.kind() == PackageReferenceKind::Purl));
+        assert!(local_keys
+            .iter()
+            .all(|key| key.coordinate.kind() == PackageReferenceKind::Local));
+        drop(projection);
+        remove_database(&both_kinds_path);
+    });
+}
+
+async fn insert_source_inventory_rows(
+    projection: &TursoProjection,
+    spelling: &str,
+    kind: PackageReferenceKind,
+    count: usize,
+) {
+    let tag = i64::from(kind.tag());
+    for byte in 1..=count {
+        let authority_id = [u8::try_from(byte).expect("fixture authority byte"); 32];
+        projection
+            .connection
+            .execute(
+                "INSERT INTO backend_projection_package_sources \
+                 (source, coordinate_kind, source_authority_kind, source_authority_id) \
+                 VALUES (?1, ?2, 1, ?3)",
+                turso::params![spelling, tag, authority_id.as_slice()],
+            )
+            .await
+            .expect("insert source inventory row");
+        projection
+            .connection
+            .execute(
+                "INSERT INTO backend_projection_package_source_witnesses \
+                 (source, coordinate_kind, source_authority_kind, source_authority_id, facts_witness) \
+                 VALUES (?1, ?2, 1, ?3, ?4)",
+                turso::params![spelling, tag, authority_id.as_slice(), [0_u8; 32].as_slice()],
+            )
+            .await
+            .expect("insert source witness inventory row");
+    }
+}
