+async fn assert_typed_collision_results(
+    projection: &TursoProjection,
+    purl_key: &PackageGraphSourceKey,
+    local_key: &PackageGraphSourceKey,
+    purl_edge: &PackageDependencyRecord,
+) {
+    let purl = projection
+        .package_dependencies_for_source(purl_key)
+        .await
+        .expect("exact PURL source");
+    assert_eq!(purl.edges.as_ref(), [purl_edge.clone()]);
+    assert_eq!(
+        purl.source_selection,
+        PackageGraphSourceSelection::Exact(purl_key.clone())
+    );
+    let local = projection
+        .package_dependencies_for_source(local_key)
+        .await
+        .expect("exact Local source");
+    assert!(local.edges.is_empty());
+    let state = local.state.expect("Local Unknown state");
+    assert_eq!(state.source, local_key.coordinate.clone());
+    assert_eq!(state.kind, 1);
+    assert_eq!(state.reason, "local source omitted facts");
+    assert_eq!(
+        local.source_selection,
+        PackageGraphSourceSelection::Exact(local_key.clone())
+    );
+    assert!(matches!(
+        projection
+            .package_dependencies(&purl_key.coordinate)
+            .await
+            .expect("PURL lookup")
+            .source_selection,
+        PackageGraphSourceSelection::Exact(ref source) if source == purl_key
+    ));
+    assert!(matches!(
+        projection
+            .package_dependencies(&local_key.coordinate)
+            .await
+            .expect("Local lookup")
+            .source_selection,
+        PackageGraphSourceSelection::Exact(ref source) if source == local_key
+    ));
+}
+
+async fn assert_coordinate_kind_rows(
+    projection: &TursoProjection,
+    spelling: &str,
+    expected_edge_kinds: &[i64],
+    expected_states: &[(i64, i64)],
+) {
+    for table in [
+        "backend_projection_package_sources",
+        "backend_projection_package_source_witnesses",
+    ] {
+        let mut rows = projection
+            .connection
+            .query(
+                &format!(
+                    "SELECT coordinate_kind FROM {table} WHERE source=?1 ORDER BY coordinate_kind"
+                ),
+                turso::params![spelling],
+            )
+            .await
+            .unwrap_or_else(|error| panic!("{table} typed inventory: {error}"));
+        let mut kinds = Vec::new();
+        while let Some(row) = rows.next().await.expect("typed inventory row") {
+            kinds.push(row.get::<i64>(0).expect("coordinate kind"));
+        }
+        assert_eq!(
+            kinds,
+            [
+                i64::from(PackageReferenceKind::Purl.tag()),
+                i64::from(PackageReferenceKind::Local.tag())
+            ],
+            "{table} must persist both same-text typed identities"
+        );
+    }
+    let mut edges = projection
+        .connection
+        .query(
+            "SELECT coordinate_kind FROM backend_projection_package_edges \
+             WHERE source=?1 ORDER BY coordinate_kind",
+            turso::params![spelling],
+        )
+        .await
+        .expect("typed edges");
+    let mut edge_kinds = Vec::new();
+    while let Some(row) = edges.next().await.expect("typed edge row") {
+        edge_kinds.push(row.get::<i64>(0).expect("kind"));
+    }
+    assert_eq!(edge_kinds, expected_edge_kinds);
+    let mut states = projection
+        .connection
+        .query(
+            "SELECT coordinate_kind, state FROM backend_projection_package_states \
+             WHERE source=?1 ORDER BY coordinate_kind",
+            turso::params![spelling],
+        )
+        .await
+        .expect("typed states");
+    let mut stored_states = Vec::new();
+    while let Some(row) = states.next().await.expect("typed state row") {
+        stored_states.push((
+            row.get::<i64>(0).expect("coordinate kind"),
+            row.get::<i64>(1).expect("state kind"),
+        ));
+    }
+    assert_eq!(stored_states, expected_states);
+}
