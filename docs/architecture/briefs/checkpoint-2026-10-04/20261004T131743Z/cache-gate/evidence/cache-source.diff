diff --git a/.config/scripts/cargo-rustc-cache.sh b/.config/scripts/cargo-rustc-cache.sh
index 114616ec4f..248bc442a6 100755
--- a/.config/scripts/cargo-rustc-cache.sh
+++ b/.config/scripts/cargo-rustc-cache.sh
@@ -84,11 +84,24 @@ if [ "$crate_type_count" -eq 1 ] \
   # workspace. Keep such sources on direct rustc so sccache never treats a
   # workspace input as an immutable external crate.
   if [ ! -L "$source" ]; then
-    case "$source" in
-      "$cargo_home"/registry/src/*|"$cargo_home"/git/checkouts/*)
-        exec @sccache@ "$compiler" "$@"
-        ;;
-    esac
+    # A private CargoHome may share these leaves through symlinks. Resolve the
+    # allowlisted roots too, then compare the already-canonical source parent
+    # against their physical locations. Missing/unresolvable roots stay empty
+    # and therefore fail closed. Only the known registry/git roots are
+    # admitted; workspace, vendor, build-script, proc-macro and unfamiliar
+    # invocations still go straight to rustc.
+    registry_src_root="$(CDPATH= cd -P "$cargo_home/registry/src" 2>/dev/null && pwd -P || true)"
+    git_checkouts_root="$(CDPATH= cd -P "$cargo_home/git/checkouts" 2>/dev/null && pwd -P || true)"
+    if [ -n "$registry_src_root" ]; then
+      case "$source" in
+        "$registry_src_root"/*) exec @sccache@ "$compiler" "$@" ;;
+      esac
+    fi
+    if [ -n "$git_checkouts_root" ]; then
+      case "$source" in
+        "$git_checkouts_root"/*) exec @sccache@ "$compiler" "$@" ;;
+      esac
+    fi
   fi
 fi
 
diff --git a/tests/cargo-shared-cache.sh b/tests/cargo-shared-cache.sh
index 4ae035d369..7c31d26754 100755
--- a/tests/cargo-shared-cache.sh
+++ b/tests/cargo-shared-cache.sh
@@ -326,6 +326,46 @@ case "$(tail -n 1 "$rustc_direct_log")" in
   *) fail "symlinked workspace source was not passed directly to rustc" ;;
 esac
 
+# Build receipts use a private CargoHome whose registry/git leaves resolve to
+# a shared cache root. Both roots and source parents must be canonicalized so
+# ordinary third-party libraries still use sccache through that layout.
+linked_cargo_home="$test_root/private cargo home"
+shared_cargo_home="$test_root/shared cargo home"
+mkdir -p "$linked_cargo_home" \
+  "$shared_cargo_home/registry/src/index.crates.io-1/linked-1/src" \
+  "$shared_cargo_home/git/checkouts/linked-example-1/commit/src"
+ln -s "$shared_cargo_home/registry" "$linked_cargo_home/registry"
+ln -s "$shared_cargo_home/git" "$linked_cargo_home/git"
+linked_registry_source="$linked_cargo_home/registry/src/index.crates.io-1/linked-1/src/lib.rs"
+linked_git_source="$linked_cargo_home/git/checkouts/linked-example-1/commit/src/lib.rs"
+: > "$linked_registry_source"
+: > "$linked_git_source"
+CARGO_HOME="$linked_cargo_home" SCCACHE_TEST_LOG="$rustc_cache_log" \
+  SCCACHE_TEST_STATUS=0 RUSTC_TEST_LOG="$rustc_direct_log" \
+  "$test_root/rustc-cache-wrapper" "$test_root/bin/rustc" \
+  --crate-name linked_registry --crate-type lib "$linked_registry_source" --out-dir "$test_root/output"
+CARGO_HOME="$linked_cargo_home" SCCACHE_TEST_LOG="$rustc_cache_log" \
+  SCCACHE_TEST_STATUS=0 RUSTC_TEST_LOG="$rustc_direct_log" \
+  "$test_root/rustc-cache-wrapper" "$test_root/bin/rustc" \
+  --crate-name linked_git --crate-type rlib "$linked_git_source" --out-dir "$test_root/output"
+assert_file_lines "$rustc_cache_log" 4
+assert_file_lines "$rustc_direct_log" 6
+
+# Canonicalizing the parent must also reject source paths that escape the
+# registry through an intermediate directory symlink. A missing registry/git
+# root cannot create an absolute-path wildcard and remains direct-rustc.
+registry_escaping_parent="$rustc_cache_home/registry/src/index.crates.io-1/escaping-package"
+ln -s "$rustc_cache_workspace/src" "$registry_escaping_parent"
+run_rustc_cache_case escaping_parent lib "$registry_escaping_parent/lib.rs"
+missing_roots_home="$test_root/cargo home without cache roots"
+mkdir -p "$missing_roots_home"
+CARGO_HOME="$missing_roots_home" SCCACHE_TEST_LOG="$rustc_cache_log" \
+  SCCACHE_TEST_STATUS=0 RUSTC_TEST_LOG="$rustc_direct_log" \
+  "$test_root/rustc-cache-wrapper" "$test_root/bin/rustc" \
+  --crate-name missing_roots --crate-type lib "$registry_source" --out-dir "$test_root/output"
+assert_file_lines "$rustc_cache_log" 4
+assert_file_lines "$rustc_direct_log" 8
+
 # Metadata and formatting remain unrestricted and do not require a socket or
 # a mutable build directory.
 metadata_log="$test_root/metadata.log"
