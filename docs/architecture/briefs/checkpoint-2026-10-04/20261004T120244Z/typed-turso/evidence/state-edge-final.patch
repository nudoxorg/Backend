+async fn assert_typed_collision_results(
+    projection: &TursoProjection,
+    purl_key: &PackageGraphSourceKey,
+    local_key: &PackageGraphSourceKey,
+    purl_edge: &PackageDependencyRecord,
+) {
+    let purl = projection
+        .package_dependencies_for_source(purl_key)
+        .await
+        .expect("exact PURL source");
+    assert_eq!(purl.edges.as_ref(), [purl_edge.clone()]);
+    assert_eq!(
+        purl.source_selection,
+        PackageGraphSourceSelection::Exact(purl_key.clone())
+    );
+    let local = projection
+        .package_dependencies_for_source(local_key)
+        .await
+        .expect("exact Local source");
+    assert!(local.edges.is_empty());
+    let state = local.state.expect("Local Unknown state");
+    assert_eq!(state.source, local_key.coordinate.clone());
+    assert_eq!(state.kind, 1);
+    assert_eq!(state.reason, "local source omitted facts");
+    assert_eq!(
+        local.source_selection,
+        PackageGraphSourceSelection::Exact(local_key.clone())
+    );
+    assert!(matches!(
+        projection
+            .package_dependencies(&purl_key.coordinate)
+            .await
+            .expect("PURL lookup")
+            .source_selection,
+        PackageGraphSourceSelection::Exact(ref source) if source == purl_key
+    ));
+    assert!(matches!(
+        projection
+            .package_dependencies(&local_key.coordinate)
+            .await
+            .expect("Local lookup")
+            .source_selection,
+        PackageGraphSourceSelection::Exact(ref source) if source == local_key
+    ));
+}
