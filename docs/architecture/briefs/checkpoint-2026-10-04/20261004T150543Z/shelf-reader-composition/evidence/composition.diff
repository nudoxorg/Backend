+#[gpui::test]
+fn focused_find_editor_keeps_its_page_keys(cx: &mut TestAppContext) {
+    let route = Route::Orbit(OrbitRoute::Browse(BrowseRoute::FindHome));
+    let mut rig = rig(cx, Some(route.clone()), 764.0, 510.0);
