+        assert_eq!(declarations.len(), 6);
+        for group in ["dev", "test"] {
+            assert_eq!(
+                declarations
+                    .iter()
+                    .filter(|row| row.group.as_deref() == Some(group))
+                    .count(),
+                2
+            );
