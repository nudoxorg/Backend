+                        package: coordinate.clone(),
+                    },
+                ),
+                (
+                    4,
+                    S::PackageProfile {
+                        package: local.clone(),
+                    },
+                ),
+                (
+                    5,
+                    S::IndexSearch {
+                        query: backend_library::ProductText::from_static("httpie"),
+                        limit: 10,
+                        cursor: None,
+                    },
+                ),
+            ] {
+                let request = 0x2a00 + epoch * 16 + offset;
+                let body = serde_json::to_vec(&backend_engine::CommandDto::new(
