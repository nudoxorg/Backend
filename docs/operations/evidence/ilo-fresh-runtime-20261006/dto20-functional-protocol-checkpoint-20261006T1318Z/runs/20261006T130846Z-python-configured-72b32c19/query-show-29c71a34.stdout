ate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"33051a01"},{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-72b32c19/project::semantic::fe4f4bb13b1cb3dfc763b95b7ab771c88a2033675b3e0a8de25429c88450fe22::decorator","trail":"project › src/decorator/__init__.py:296 › decorator","name":"decorator","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-72b32c19/project","path":"src/decorator/__init__.py","line":296,"segments":["decorator"],"key":"5fa67dbe"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"5ffef159"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"6237e657"},{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-72b32c19/project::semantic::ba8cf336fabc2bd060b7a0094015c8c6970604b28cbcb596c662aef0ec3a772c::decorate","trail":"project › src/decorator/__init__.py:222 › decorate","name":"decorate","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-72b32c19/project","path":"src/decorator/__init__.py","line":222,"segments":["decorate"],"key":"70fd2f13"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"8c33226f"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"8e17d005"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"90921d72"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"946feda6"},{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-72b32c19/project::semantic::c1e9672f9793bea3afa7ea1c1563ce7f8fd98f70dc5f7269187e84b0a41232ba::inspect_sig","trail":"project › src/decorator/__init__.py:47 › inspect_sig","name":"inspect_sig","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-72b32c19/project","path":"src/decorator/__init__.py","line":47,"segments":["inspect_sig"],"key":"9b9f867e"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"a23ae993"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"c72c3f38"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"dc821506"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"e9d0f057"}]}],"source":{"path":"src/decorator/__init__.py","line":296,"lines":["def decorator(caller, _func=None, kwsyntax=False):","    \"\"\"","    decorator(caller) converts a caller function into a decorator","    \"\"\"","    if _func is not None:  # return a decorated function","        # this is obsolete behavior; you should use decorate instead","        return decorate(_func, caller, (), kwsyntax)","    # else return a decorator function","    sig = inspect_sig(caller)","    dec_params = [p for p in sig.parameters.values() if p.kind is POS]","","    def dec(func=None, *args, **kw):","        na = len(args) + 1","        extras = args + tuple(kw.get(p.name, p.default)","                              for p in dec_params[na:]","                              if p.default is not EMPTY)","        if func is None:","            return lambda func: decorate(func, caller, extras, kwsyntax)","        else:","            return decorate(func, caller, extras, kwsyntax)","    dec.__signature__ = sig.replace(parameters=dec_params)","    dec.__name__ = caller.__name__","    dec.__doc__ = caller.__doc__","    dec.__wrapped__ = caller","    dec.__qualname__ = caller.__qualname__","    dec.__kwdefaults__ = getattr(caller, '__kwdefaults__', None)","    dec.__dict__.update(caller.__dict__)","    return dec"],"extent":"complete"},"answer":"page","detail":"full","budget":{"bytes":7154,"estimatedTokens":1789,"bytesPerToken":4}}