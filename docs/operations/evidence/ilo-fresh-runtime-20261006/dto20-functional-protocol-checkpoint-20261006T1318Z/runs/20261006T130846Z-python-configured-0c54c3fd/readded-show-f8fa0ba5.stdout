{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project::toolz/functoolz.py:560::compose","trail":"project › toolz/functoolz.py:560 › compose","name":"compose","shape":"declaration","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project","path":"toolz/functoolz.py","line":560,"segments":["compose"],"key":"b6a48246"},"language":"python","signature":"def compose(*funcs):","tokens":[{"text":"def","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compose","kind":"name"},{"text":"(","kind":"punctuation"},{"text":"*","kind":"punctuation"},{"text":"funcs","kind":"text"},{"text":")","kind":"punctuation"},{"text":":","kind":"punctuation"}],"prose":["Compose functions to operate in series.\n\n    Returns a function that applies other functions in sequence.\n\n    Functions are applied from right to left so that\n    ``compose(f, g, h)(x, y)`` is the same as ``f(g(h(x, y)))``.\n\n    If no arguments are provided, the identity function (f(x) = x) is returned.\n\n    >>> inc = lambda i: i + 1\n    >>> compose(str, inc)(3)\n    '4'\n\n    See Also:\n        compose_left\n        pipe"],"relations":[{"label":"called by","relations":[{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project::toolz/tests/test_functoolz.py:574::test_compose_metadata","trail":"project › toolz/tests/test_functoolz.py:574 › test_compose_metadata","name":"test_compose_metadata","shape":"declaration","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project","path":"toolz/tests/test_functoolz.py","line":574,"segments":["test_compose_metadata"],"key":"731cd15b"},{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project::toolz/functoolz.py:586::compose_left","trail":"project › toolz/fu