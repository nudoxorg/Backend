{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project::toolz/functoolz.py:586::compose_left","trail":"project › toolz/functoolz.py:586 › compose_left","name":"compose_left","shape":"declaration","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T130846Z-python-configured-0c54c3fd/project","path":"toolz/functoolz.py","line":586,"segments":["compose_left"],"key":"d0d34478"},"language":"python","signature":"def compose_left(*funcs):","tokens":[{"text":"def","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compose_left","kind":"name"},{"text":"(","kind":"punctuation"},{"text":"*","kind":"punctuation"},{"text":"funcs","kind":"text"},{"text":")","kind":"punctuation"},{"text":":","kind":"punctuation"}],"prose":["Compose functions to operate in series.\n\n    Returns a function that applies other functions in sequence.\n\n    Functions are applied from left to right so that\n    ``compose_left(f, g, h)(x, y)`` is the same as ``h(g(f(x, y)))``.\n\n    If no arguments are provided, the identity function (f(x) = x) is returned.\n\n    >>> inc = lambda i: i + 1\n    >>> compose_left(inc, str)(3)\n    '4'\n\n    See Also:\n        compose\n        pipe"],"source":{"path":"toolz/functoolz.py","line":586,"lines":["def compose_left(*funcs):","    \"\"\" Compose functions to operate in series.","","    Returns a function that applies other functions in sequence.","","    Functions are applied from left to right so that","    ``compose_left(f, g, h)(x, y)`` is the same as ``h(g(f(x, y)))``.","","    If no arguments are provided, the identity function (f(x) = x) is returned.","","    >>> inc = lambda i: i + 1","    >>> compose_left(inc, str)(3)","    '4'","","    See Also:","        compose","        pipe","    \"\"\"","    return compose(*reversed(funcs))"],"extent":"complete"},"answer":"page","detail":"full","budget":{"bytes":1998,"estimatedTokens":500,"bytesPerToken":4}}