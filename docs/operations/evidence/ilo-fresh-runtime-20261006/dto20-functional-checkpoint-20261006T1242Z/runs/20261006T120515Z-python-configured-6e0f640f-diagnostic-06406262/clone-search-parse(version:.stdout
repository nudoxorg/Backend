{"query":"parse(version:","coverage":[{"lane":"exact","state":"complete"},{"lane":"names","state":"complete"},{"lane":"graph","state":"complete"},{"lane":"semantic","state":"unavailable","reason":"unconfigured"}],"readiness":"ready","records":[{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::086dd0315ec8528427b1af3bc523866548571e86cb117d85b3cbe7800cca28d9::TestReleaseSegmentOrdering","trail":"project › tests/property/test_version_ordering.py:66 › TestReleaseSegmentOrdering","name":"TestReleaseSegmentOrdering","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"tests/property/test_version_ordering.py","line":66,"segments":["TestReleaseSegmentOrdering"],"key":"2f7bce46"},"kind":"struct","language":"python","state":"ready","signature":"class TestReleaseSegmentOrdering:","summary":"The release segment of version identifiers MUST be sorted in","score":4294967293},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::6b75ef8582ef0b4749155667f5a915b7e81577364d70daa1c5099ad2a68740b9::Marker","trail":"project › src/packaging/markers.py:380 › Marker","name":"Marker","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/markers.py","line":380,"segments":["Marker"],"key":"51145daa"},"kind":"struct","language":"python","state":"ready","signature":"class Marker:\n    \"\"\"Represents a parsed dependency marker expression.\n\n    Marker expressions are parsed according to the\n    :ref:`specification of dependency specifiers <pypug:dependency-specifiers>`.\n\n    :param marker: The string representation of a marker expression.\n    :raises InvalidMarker: If ``marker`` cannot be parsed.\n\n    Instances are safe to serialize with :mod:`pickle`. They use a stable\n    format so the same pickle can be loaded in future packaging releases.\n\n    .. versionchanged:: 26.2\n\n        Added a stable pickle format. Pickles created with packaging 26.2+ can\n        be unpickled with future releases.  Backward compatibility with pickles\n        from packaging < 26.2 is supported but may be removed in a future\n        release.\n    \"\"\"\n\n    __slots__ = (\"_markers\",)\n\n    def __init__(self, marker: str) -> None:\n        # Note: We create a Marker object without calling this constructor in\n        #       packaging.requirements.Requirement. If any additional logic is\n        #       added here, make sure to mirror/adapt Requirement.\n\n        # If this fails and throws an error, the repr still expects _markers to\n        # be defined.\n        self._markers: MarkerList = []\n\n        try:\n            self._markers = _normalize_extra_values(_parse_marker(marker))\n            # The attribute `_markers` can be described in terms of a recursive type:\n            # MarkerList = List[Union[Tuple[Node, ...], str, MarkerList]]\n            #\n            # For example, the following expression:\n            # python_version > \"3.6\" or (python_version == \"3.6\" and os_name == \"unix\")\n            #\n            # is parsed into:\n            # [\n            #     (<Variable('python_version')>, <Op('>')>, <Value('3.6')>),\n            #     'and',\n            #     [\n            #         (<Variable('python_version')>, <Op('==')>, <Value('3.6')>),\n            #         'or',\n            #         (<Variable('os_name')>, <Op('==')>, <Value('unix')>)\n            #     ]\n            # ]\n        except ParserSyntaxError as e:\n            raise InvalidMarker(str(e)) from e\n\n    @classmethod\n    def _from_markers(cls, markers: MarkerList) -> Marker:\n        \"\"\"Create a Marker instance from a pre-parsed marker tree.\n\n        This avoids re-parsing serialised marker strings when combining markers.\n        \"\"\"\n        new = cls.__new__(cls)\n        new._markers = markers\n        return new\n\n    def __str__(self) -> str:\n        return _format_marker(self._markers)\n\n    def __repr__(self) -> str:\n        return f\"<","summary":"Represents a parsed dependency marker expression.","score":4294967290},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::762eab6fde275b8011d2bf291762dba7b17bcc9dc382a5d3868c43a551d3d313::singleton","trail":"project › src/packaging/ranges.py:1163 › singleton","name":"singleton","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/ranges.py","line":1163,"segments":["singleton"],"key":"65390495"},"kind":"function","language":"python","state":"ready","signature":"@classmethod\n    def singleton(\n        cls, version: Version | str, *, prereleases: bool | None = None\n    ) -> VersionRange:\n        \"\"\"Return the strict singleton range ``","summary":"Return the strict singleton range ``{version}``.","score":4294967286},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::a0185b01782fe623d98d6058c9feb0c1f0b940419eee3c3e90f33a7551225c25::_get_musl_version","trail":"project › src/packaging/_musllinux.py:37 › _get_musl_version","name":"_get_musl_version","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/_musllinux.py","line":37,"segments":["_get_musl_version"],"key":"682a27ff"},"kind":"function","language":"python","state":"ready","signature":"@functools.lru_cache","summary":"Detect currently-running musl runtime version.","score":4294967287},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::51b3615f670625c399e426f5df35e7874a728eefd657ce347b2ba2db9e350fe9::Specifier","trail":"project › src/packaging/specifiers.py:220 › Specifier","name":"Specifier","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/specifiers.py","line":220,"segments":["Specifier"],"key":"6f2e6c6c"},"kind":"struct","language":"python","state":"ready","signature":"class Specifier(BaseSpecifier):\n    \"\"\"This class abstracts handling of version specifiers.\n\n    .. tip::\n\n        It is generally not required to instantiate this manually. You should instead\n        prefer to work with :class:`SpecifierSet` instead, which can parse\n        comma-separated version specifiers (which is what package metadata contains).\n\n    Instances are safe to serialize with :mod:`pickle`. They use a stable\n    format so the same pickle can be loaded in future packaging releases.\n\n    .. versionchanged:: 26.2\n\n        Added a stable pickle format. Pickles created with packaging 26.2+ can\n        be unpickled with future releases.  Backward compatibility with pickles\n        from packaging < 26.2 is supported but may be removed in a future\n        release.\n    \"\"\"\n\n    __slots__ = (\n        \"_prereleases\",\n        \"_ranges\",\n        \"_spec\",\n        \"_spec_version\",\n    )\n\n    _specifier_regex_str = r\"\"\"\n        (?:\n            (?:\n                # The identity operators allow for an escape hatch that will\n                # do an exact string match of the version you wish to install.\n                # This will not be parsed by PEP 440 and we cannot determine\n                # any semantic meaning from it. This operator is discouraged\n                # but included entirely as an escape hatch.\n                ===  # Only match for the identity operator\n                \\s*\n                [^\\s;)]*  # The arbitrary version can be just about anything,\n                          # we match everything except for whitespace, a\n                          # semi-colon for marker support, and a closing paren\n                          # since versions can be enclosed in them.\n            )\n            |\n            (?:\n                # The (non)equality operators allow for wild card and local\n                # versions to be specified so we have to define these two\n                # operators separately to enable that.\n                (?:==|!=)            # Only match for equals and not equals\n\n                \\s*\n                v?\n                (?:[0-9]+!)?          # epoch\n                [0-9]+(?:\\.[0-9]+)*   # release\n\n                # You cannot use a wild card and a pre-release, post-release, a dev or\n                # local version together so group them with a | and make them optional.\n                (?:\n                    \\.\\*  # Wild card syntax of .*\n                    |\n                    (?a:                                  # pre release\n                        [-_\\.]?\n                        (alpha|beta|preview|pre|a|b|c|rc)\n                        [-_\\.]?\n                        [0-9]*\n                    )?\n                    (?a:                                  # post release\n                        (?:-[0-9]+)|(?:[-_\\.]?(post|rev|r)[-_\\.]?[0-9]*)\n                    )?\n                    (?a:[-_\\.]?dev[-_\\.]?[0-9]*)?         # dev release\n                    (?a:\\+[a-z0-9]+(?:[-_\\.][a-z0-9]+)*)? # local\n                )?\n            )\n            |\n            (?:\n                # The compatible operator requires at least two digits in the\n                # release segment.\n                (?:~=)               # Only match for the compatible operator\n\n                \\s*\n                v?\n                (?:[0-9]+!)?          # epoch\n                [0-9]+(?:\\.[0-9]+)+   # release  (We have a + instead of a *)\n                (?:                   # pre release\n                    [-_\\.]?\n                    (alpha|beta|preview|pre|a|b|c|rc)\n                    [-_\\.]?\n                    [0-9]*\n                )?\n                (?:                                   # post release\n                    (?:-[0-9]+)|(?:[-_\\.]?(post|rev|r)[-_\\.]?[0-9]*)\n                )?\n                (?:[-_\\.]?dev[-_\\.]?[0-9]*)?          # dev release\n            )\n            |\n            (?:\n                # All other operators only allow a sub set of what the\n                # (non)equality operators do. Specifically they do not allow\n                # local versions to be specified nor do the","summary":"This class abstracts handling of version specifiers.","score":4294967295},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::2f07dab302ad661e1fb55f530c10f9939ef0f510ddf174c8a61758c71879bb7d::TestSpecifierInternal","trail":"project › tests/test_specifiers.py:1106 › TestSpecifierInternal","name":"TestSpecifierInternal","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"tests/test_specifiers.py","line":1106,"segments":["TestSpecifierInternal"],"key":"7abcdfa1"},"kind":"struct","language":"python","state":"ready","signature":"class TestSpecifierInternal:","summary":"Tests for internal Specifier._spec_version cache behavior.","score":4294967294},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::8a2623ba34bbdd69b536168ef0614a24f1a0ad0307030f7e39584feb6265c6b5::RFC822Policy","trail":"project › src/packaging/metadata.py:318 › RFC822Policy","name":"RFC822Policy","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/metadata.py","line":318,"segments":["RFC822Policy"],"key":"84ecac3c"},"kind":"struct","language":"python","state":"ready","signature":"class RFC822Policy(email.policy.EmailPolicy):","summary":"This is :class:`email.policy.EmailPolicy`, but with a simple ``header_store_parse``","score":4294967289},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::3cbbada9c7edfead9ae5504f8c1c00919a96c185483f4811796d739355b56c92::parse","trail":"project › src/packaging/version.py:110 › parse","name":"parse","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/version.py","line":110,"segments":["parse"],"key":"a75c4a2a"},"kind":"function","language":"python","state":"ready","signature":"def parse(version: str) -> Version:","summary":"Parse the given version string.","score":4294967288},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::10e9b5abe97c834058336ab8994298f20d237f27cd68e3eeb1834edd2de182fc::Requirement","trail":"project › src/packaging/requirements.py:35 › Requirement","name":"Requirement","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"src/packaging/requirements.py","line":35,"segments":["Requirement"],"key":"ca1daf7f"},"kind":"struct","language":"python","state":"ready","signature":"class Requirement:\n    \"\"\"Parse a requirement.\n\n    Parse a given requirement string into its parts, such as name, specifier,\n    URL, and extras. Raises InvalidRequirement on a badly-formed requirement\n    string.\n\n    .. versionadded:: 16.1\n\n    .. versionchanged:: 22.0\n        Added equality (``__eq__``) and hashing (``__hash__``) so requirements\n        can be compared and stored in sets / dicts.\n\n    .. versionchanged:: 23.2\n        Equality and hashing began canonicalizing requirement names, so\n        requirements whose names differ only by normalization (e.g.\n        ``Requirement(\"Foo\")`` vs ``Requirement(\"foo\")``) now compare and hash\n        equal.\n\n    Instances are safe to serialize with :mod:`pickle`. They use a stable\n    format so the same pickle can be loaded in future packaging releases.\n\n    .. versionchanged:: 26.2\n\n        Added a stable pickle format. Pickles created with packaging 26.2+ can\n        be unpickled with future releases.  Backward compatibility with pickles\n        from packaging < 26.2 is supported but may be removed in a future\n        release.\n\n    .. versionchanged:: 26.3\n\n        The dedicated pickle support introduced in 26.2 did not preserve the\n        specifier's explicit :attr:`~packaging.specifiers.SpecifierSet.prereleases`\n        override; it is now included again.\n\n        Equality and hashing normalize requirement names, extras, and\n        equivalent specifiers. The string representation still preserves the\n        parsed name and extras spelling.\n    \"\"\"\n\n    # TODO: Can we test whether something is contained within a requirement?\n    #       If so how do we do that? Do we need to test against the _name_ of\n    #       the thing as well as the version? What about the markers?\n    # TODO: Can we normalize the name and extra name?\n\n    __slots__ = (\"extras\", \"marker\", \"name\", \"specifier\", \"url\")\n\n    def __init__(self, requirement_string: str) -> None:\n        try:\n            parsed = _parse_requirement(requirement_string)\n        except ParserSyntaxError as e:\n            raise InvalidRequirement(str(e)) from e\n\n        self.name: str = parsed.name\n        self.url: str | None = parsed.url or None\n        self.extras: set[str] = set(parsed.extras)\n        try:\n            self.specifier: SpecifierSet = SpecifierSet(parsed.specifier)\n        except InvalidSpecifier as e:\n            raise InvalidRequirement(str(e)) from e\n        self.marker: Marker | None = None\n        if parsed.marker is not None:\n            self.marker = Marker.__new__(Marker)\n            self.marker._markers = _normalize_extra_values(parsed.marker)\n\n    def _iter_parts(self, name: str) -> Iterator[str]:\n        yield name\n\n        if self.extras:\n            formatted_extras = \",\".join(sorted(self.extras))\n            yield f\"[","summary":"Parse a requirement.","score":4294967291},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project::semantic::b65fc025e44554ff18148f672c739d810874f422280e49b9b91e0f216cc1c68b::TestVersionPropertyConsistency","trail":"project › tests/property/test_specifier_implied.py:152 › TestVersionPropertyConsistency","name":"TestVersionPropertyConsistency","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-6e0f640f/project","path":"tests/property/test_specifier_implied.py","line":152,"segments":["TestVersionPropertyConsistency"],"key":"d22e9852"},"kind":"struct","language":"python","state":"ready","signature":"class TestVersionPropertyConsistency:","summary":"Implied by the version scheme: the .public, .base_version, .major,","score":4294967292}],"more":true,"semantic_search":{"status":"unavailable","reason":"unconfigured"},"answer":"records","detail":"full","budget":{"bytes":17693,"estimatedTokens":4424,"bytesPerToken":4}}