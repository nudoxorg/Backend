{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T123013Z-python-configured-283108bd/project::semantic::1cd82202b690e4e285c3bca481c8a3fffe1c03d422279128d3cd5f555f7e3f81::current_async_library","trail":"project › sniffio/_impl.py:25 › current_async_library","name":"current_async_library","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T123013Z-python-configured-283108bd/project","path":"sniffio/_impl.py","line":25,"segments":["current_async_library"],"key":"913f5b0e"},"kind":"function","language":"python","state":"ready","signature":"def current_async_library() -> str:\n    \"\"\"Detect which async library is currently running.\n\n    The following libraries are currently supported:\n\n    ================   ===========  ============================\n    Library             Requires     Magic string\n    ================   ===========  ============================\n    **Trio**            Trio v0.6+   ``\"trio\"``\n    **Curio**           -            ``\"curio\"``\n    **asyncio**                      ``\"asyncio\"``\n    **Trio-asyncio**    v0.8.2+     ``\"trio\"`` or ``\"asyncio\"``,\n                                    depending on current mode\n    ================   ===========  ============================\n\n    Returns:\n      A string like ``\"trio\"``.\n\n    Raises:\n      AsyncLibraryNotFoundError: if called from synchronous context,\n        or if the current async library was not recognized.\n\n    Examples:\n\n        .. code-block:: python3\n\n           from sniffio import current_async_library\n\n           async def generic_sleep(seconds):\n               library = current_async_library()\n               if library == \"trio\":\n                   import trio\n                   await trio.sleep(seconds)\n               elif library == \"asyncio\":\n                   import asyncio\n                   await asyncio.sleep(seconds)\n               # ... and so on ...\n               else:\n                   raise RuntimeError(f\"Unsupported library","summary":"Detect which async library is currently running."},{"identity":{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"9d62abfd"},"language":"unknown","state":"ready"},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T123013Z-python-configured-283108bd/project::semantic::25dda166d93f66f0304c94d84f97c2109165ffbfda9a00113de20b8171dc6a51::AsyncLibraryNotFoundError","trail":"project › sniffio/_impl.py:21 › AsyncLibraryNotFoundError","name":"AsyncLibraryNotFoundError","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T123013Z-python-configured-283108bd/project","path":"sniffio/_impl.py","line":21,"segments":["AsyncLibraryNotFoundError"],"key":"dcc3b794"},"kind":"struct","language":"python","state":"ready","signature":"class AsyncLibraryNotFoundError(RuntimeError):"}],"more":false,"answer":"records","detail":"full","budget":{"bytes":5196,"estimatedTokens":1299,"bytesPerToken":4}}