{"query":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project::semantic::630905a99618ec66b9a9261d8ff04f979a96c185483f4811796d739355b56c92::parse","coverage":[{"lane":"exact","state":"complete"},{"lane":"names","state":"complete"},{"lane":"graph","state":"complete"},{"lane":"semantic","state":"unavailable","reason":"unconfigured"}],"readiness":"ready","records":[{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project::semantic::630905a99618ec66b9a9261d8ff04f979a96c185483f4811796d739355b56c92::parse","trail":"project › src/packaging/version.py:110 › parse","name":"parse","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project","path":"src/packaging/version.py","line":110,"segments":["parse"],"key":"2357d5a2"},"kind":"function","language":"python","state":"ready","signature":"def parse(version: str) -> Version:","summary":"Parse the given version string."},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project::semantic::15dda02d36a69ff74764124c88a6e9d5270d3d2cf76d03872bff99591871df3d::test_parse_raises","trail":"project › tests/test_version.py:49 › test_parse_raises","name":"test_parse_raises","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project","path":"tests/test_version.py","line":49,"segments":["test_parse_raises"],"key":"3834cb8b"},"kind":"function","language":"python","state":"ready","signature":"def test_parse_raises() -> None:"},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project::semantic::1ed5121ae17d57a2681c5cc56eadec385af62ec5e4e2c8ec03461039f070f429::Version","trail":"project › src/packaging/version.py:340 › Version","name":"Version","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project","path":"src/packaging/version.py","line":340,"segments":["Version"],"key":"3c970c16"},"kind":"struct","language":"python","state":"ready","signature":"class Version(_BaseVersion):\n    \"\"\"This class abstracts handling of a project's versions.\n\n    A :class:`Version` instance is comparison aware and can be compared and\n    sorted using the standard Python interfaces.\n\n    >>> v1 = Version(\"1.0a5\")\n    >>> v2 = Version(\"1.0\")\n    >>> v1\n    <Version('1.0a5')>\n    >>> v2\n    <Version('1.0')>\n    >>> v1 < v2\n    True\n    >>> v1 == v2\n    False\n    >>> v1 > v2\n    False\n    >>> v1 >= v2\n    False\n    >>> v1 <= v2\n    True\n\n    :class:`Version` is immutable; use :meth:`__replace__` to change\n    part of a version.\n\n    Instances are safe to serialize with :mod:`pickle`. They use a stable\n    format so the same pickle can be loaded in future packaging releases.\n\n    .. versionchanged:: 26.2\n\n        Added a stable pickle format. Pickles created with packaging 26.2+ can\n        be unpickled with future releases.  Backward compatibility with pickles\n        from packaging < 26.2 is supported but may be removed in a future\n        release.\n    \"\"\"\n\n    __slots__ = (\n        \"_dev\",\n        \"_epoch\",\n        \"_hash_cache\",\n        \"_key_cache\",\n        \"_local\",\n        \"_post\",\n        \"_pre\",\n        \"_release\",\n    )\n    __match_args__ = (\"_str\",)\n    \"\"\"\n    Pattern matching is supported on Python 3.10+.\n\n    .. versionadded:: 26.0\n\n    :meta hide-value:\n    \"\"\"\n\n    _regex = re.compile(r\"\\s*\" + VERSION_PATTERN + r\"\\s*\", re.VERBOSE | re.IGNORECASE)\n\n    _epoch: int\n    _release: tuple[int, ...]\n    _dev: tuple[Literal[\"dev\"], int] | None\n    _pre: tuple[Literal[\"a\", \"b\", \"rc\"], int] | None\n    _post: tuple[Literal[\"post\"], int] | None\n    _local: LocalType | None\n\n    _hash_cache: int | None\n    _key_cache: CmpKey | None\n\n    def __init__(self, version: str) -> None:\n        \"\"\"Initialize a Version object.\n\n        :param version:\n            The string representation of a version which will be parsed and normalized\n            before use.\n        :raises InvalidVersion:\n            If the ``version`` does not conform to PEP 440 in any way then this\n            exception will be raised.\n        \"\"\"\n        try:\n            is_simple = _SIMPLE_VERSION_INDICATORS.issuperset(version)\n        except TypeError:\n            raise InvalidVersion(f\"Invalid version:","summary":"This class abstracts handling of a project's versions."},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project::semantic::0b7c03f3927f296e471a42277a389ad67da1bfe95774025f9c65e4845dd1aff9::test_parse","trail":"project › tests/test_version.py:45 › test_parse","name":"test_parse","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project","path":"tests/test_version.py","line":45,"segments":["test_parse"],"key":"86d0d69a"},"kind":"function","language":"python","state":"ready","signature":"def test_parse() -> None:"},{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project::semantic::df3199c087057ee80b1236a4b549e6c918adaba0b34772837cbf688f08e54280::_process_version","trail":"project › src/packaging/metadata.py:641 › _process_version","name":"_process_version","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T122431Z-python-configured-49d3e7da/project","path":"src/packaging/metadata.py","line":641,"segments":["_process_version"],"key":"bd29b458"},"kind":"function","language":"python","state":"ready","signature":"def _process_version(self, value: str) -> Version:\n        if not value:\n            raise self._invalid_metadata(f\""}],"more":false,"answer":"records","detail":"full","budget":{"bytes":6256,"estimatedTokens":1564,"bytesPerToken":4}}