{"identity":{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-e8c8cc6f/project::semantic::19b8f1ee3d295d90fcabf0788ea4c28a1b9a9b4ca25ad906955fb9db1fb9f235::send_async","trail":"project › src/blinker/base.py:255 › send_async","name":"send_async","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-e8c8cc6f/project","path":"src/blinker/base.py","line":255,"segments":["send_async"],"key":"911190cd"},"language":"python","signature":"async def send_async(","tokens":[{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"def","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send_async","kind":"name"},{"text":"(","kind":"punctuation"}],"prose":["Await all receivers that are connected to the given ``sender``","or :data:`ANY`. Each receiver is called with ``sender`` as a positional","argument along with any extra keyword arguments. Return a list of","``(receiver, return value)`` tuples.","The order receivers are called is undefined, but can be influenced by","setting :attr:`set_class`.","If a receiver raises an exception, that exception will propagate up.","This makes debugging straightforward, with an assumption that correctly","implemented receivers will not raise.",":param sender: Call receivers connected to this sender, in addition to","those connected to :data:`ANY`.",":param _sync_wrapper: Will be called on any receivers that are sync","callables to turn them into async coroutines. For example,","could call the receiver in a thread.",":param kwargs: Extra keyword arguments to pass to each receiver.",".. versionadded:: 1.7"],"relations":[{"label":"related","relations":[{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"31417eb9"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"661e3b15"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"790f9074"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"86747693"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"bf0a9e84"},{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-e8c8cc6f/project::semantic::77494584b03279c121c541b9e10db15dc479c686c72235a65ed14d94c9b0c4e4::receivers_for","trail":"project › src/blinker/base.py:326 › receivers_for","name":"receivers_for","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-e8c8cc6f/project","path":"src/blinker/base.py","line":326,"segments":["receivers_for"],"key":"cde3f1bb"},{"coordinate":"external semantic target","trail":"external semantic target","name":"external semantic target","shape":"package","project":"external semantic target","segments":[],"key":"e9310e01"},{"coordinate":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-e8c8cc6f/project::semantic::19b8f1ee3d295d90fcabf0788ea4c28a1b9a9b4ca25ad906955fb9db1fb9f235::send_async","trail":"project › src/blinker/base.py:255 › send_async","name":"send_async","shape":"semantic","project":"/root/nudox-corpus-20261006/runs/fresh-remote-runtime/20261006T120515Z-python-configured-e8c8cc6f/project","path":"src/blinker/base.py","line":255,"segments":["send_async"],"key":"f1e3b430"}]}],"source":{"path":"src/blinker/base.py","line":255,"lines":["async def send_async(","        self,","        sender: t.Any | None = None,","        /,","        *,","        _sync_wrapper: c.Callable[","            [c.Callable[..., t.Any]], c.Callable[..., c.Coroutine[t.Any, t.Any, t.Any]]","        ]","        | None = None,","        **kwargs: t.Any,","    ) -> list[tuple[c.Callable[..., t.Any], t.Any]]:","        \"\"\"Await all receivers that are connected to the given ``sender``","        or :data:`ANY`. Each receiver is called with ``sender`` as a positional","        argument along with any extra keyword arguments. Return a list of","        ``(receiver, return value)`` tuples.","","        The order receivers are called is undefined, but can be influenced by","        setting :attr:`set_class`.","","        If a receiver raises an exception, that exception will propagate up.","        This makes debugging straightforward, with an assumption that correctly","        implemented receivers will not raise.","","        :param sender: Call receivers connected to this sender, in addition to","            those connected to :data:`ANY`.","        :param _sync_wrapper: Will be called on any receivers that are sync","            callables to turn them into async coroutines. For example,","            could call the receiver in a thread.","        :param kwargs: Extra keyword arguments to pass to each receiver.","","        .. versionadded:: 1.7","        \"\"\"","        if self.is_muted:","            return []","","        results = []","","        for receiver in self.receivers_for(sender):","            if not iscoroutinefunction(receiver):","                if _sync_wrapper is None:","                    raise RuntimeError(\"Cannot send to a non-coroutine function.\")","","                result = await _sync_wrapper(receiver)(sender, **kwargs)","            else:","                result = await receiver(sender, **kwargs)","","            results.append((receiver, result))","","        return results"],"extent":"complete"},"answer":"page","detail":"full","budget":{"bytes":6117,"estimatedTokens":1530,"bytesPerToken":4}}