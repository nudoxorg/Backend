# Cache configuration lives in its own file; pull it in explicitly (Buck2 does
# not auto-load buckconfig.d/). See buckconfig.d/cache.buckconfig.
<file:buckconfig.d/cache.buckconfig>

[cells]
root = .
prelude = build/prelude-local
toolchains = build/toolchains
none = none
nix = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# Nix toolchains are the DEFAULT. You can toggle back to the system toolchains with `-c nix.toolchain=0`.
# See: https://github.com/tweag/buck2.nix and build/toolchains/nix/flake.nix
[external_cells]
  nix = git

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default \
  target:prelude//...->prelude//platforms:default \
  target:toolchains//...->prelude//platforms:default

# The vendored javacd_toolchain (needed by java_library, e.g. the Java oracle
# doclet) transitively depends on a `dex` toolchain, which in turn wants an
# Android SDK. We have no actual Android code — this points at empty
# placeholder files (build/toolchains/android-sdk-stub) purely to satisfy the
# toolchain's analysis-time symlink actions; nothing here is ever read.
[android]
  sdk_path = build/toolchains/android-sdk-stub
  build_tools_version = stub
  compile_sdk_version = android-stub



# BEGIN NIX-GENERATED — managed by flake.nix devshell, do not edit
[external_cell_nix]
  path = /nix/store/1bb6gi0lcfqfxp8gghjykkzbmcz86lgk-source

[external_cells]
  nix = path

[go]
  go_binary = /nix/store/38idfbqyw3p8xaslv6bnrig62pj7qy6i-go-1.26.4/bin/go

[java]
  java_home = /nix/store/adgxs4i9zn1v0wx3dxg1frqzdccdmdvj-zulu-ca-jdk-21.0.11
# END NIX-GENERATED
