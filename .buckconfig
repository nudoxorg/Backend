# Cache configuration lives in its own file; pull it in explicitly (Buck2 does
# not auto-load buckconfig.d/). See nix/build/buckconfig.d/cache.buckconfig.
<file:nix/build/buckconfig.d/cache.buckconfig>

[cells]
root = .
prelude = nix/build/prelude-local
toolchains = nix/build/toolchains
none = none
nix = nix/build/stubs/nix
# snowydeer packaging (vendored under nix/snowydeer; labels are //snowydeer:…)
snowydeer = nix/snowydeer

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default \
  target:prelude//...->prelude//platforms:default \
  target:toolchains//...->prelude//platforms:default

# The vendored javacd_toolchain (needed by java_library, e.g. the Java oracle
# doclet) transitively depends on a `dex` toolchain, which in turn wants an
# Android SDK. We have no actual Android code — this points at empty
# placeholder files (nix/build/toolchains/android-sdk-stub) purely to satisfy the
# toolchain's analysis-time symlink actions; nothing here is ever read.
[android]
  sdk_path = nix/build/toolchains/android-sdk-stub
  build_tools_version = stub
  compile_sdk_version = android-stub

# Default: system toolchains, no Nix required. `nix develop` writes its
# machine-local overrides to the ignored `.buckconfig.local` instead of
# modifying this tracked file.
[nix]
  toolchain = 0
