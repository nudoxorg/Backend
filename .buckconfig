[cells]
root = .
prelude = build/prelude-local
toolchains = build/toolchains
none = none
# nix = none  # uncomment and configure [external_cells] below to enable Nix toolchain

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# ── Nix toolchain integration (Tweag buck2.nix approach) ──────────────────
# Uncomment the sections below to use Nix-hermetic tools via buck2.nix.
# Then in build/toolchains/BUCK, switch to flake.package() + nix_rust_toolchain.
# See: https://github.com/tweag/buck2.nix and build/toolchains/nix/flake.nix
#
# [external_cells]
#   nix = git
#
# [external_cell_nix]
#   git_origin = https://github.com/tweag/buck2.nix.git
#   commit_hash = accae8c8924b3b51788d0fbd6ac90049cdf4f45a
# ──────────────────────────────────────────────────────────────────────────

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default \
  target:prelude//...->prelude//platforms:default \
  target:toolchains//...->prelude//platforms:default
