#!/bin/sh
set -eu

# The Rust lane invokes this file as the native helper.  Keep the JVM pinned to
# the executable proved in BACKEND_NATIVE_TOOLCHAIN rather than consulting a
# host PATH.  `javac` and `java` live beside one another in a JDK.
helper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${BACKEND_NATIVE_TOOLCHAIN:-}" ]; then
    java_bin=${BACKEND_NATIVE_TOOLCHAIN%/*}/java
else
    java_bin=java
fi
exec "$java_bin" --add-modules jdk.compiler,jdk.javadoc "$helper_dir/BackendJavaSemantic.java" "$@"
