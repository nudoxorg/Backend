load("//build:rust.bzl", "deps", "rust_crate", "rust_tests", "target")

rust_crate(
    name = "version",
    deps = deps([]),
)

# Unit tests live inside lib.rs (private helpers need access to crate internals).
# Buck2 requires a separate rust_test with crate_root = "lib.rs" to exercise them.
native.rust_test(
    name = "test-unit",
    srcs = native.glob(["**/*.rs"]),
    crate_root = "lib.rs",
    edition = "2024",
    deps = deps([]),
)

rust_tests(
    prefix = "test",
    deps = deps([
        target(":version"),
    ]),
)
