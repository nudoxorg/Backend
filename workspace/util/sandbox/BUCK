load("//build:rust.bzl", "crate", "deps", "member", "rust_crate", "rust_tests", "target")

# Linux-only isolation crates (Landlock LSM + seccomp BPF). Gated so macOS
# analysis never builds them.
_LINUX_DEPS = [
    "//build/third-party:landlock",
    "//build/third-party:seccompiler",
    "//build/third-party:libc",
]

rust_crate(
    name = "sandbox",
    deps = deps([
        # Vocabulary crate (ContentHash / JobKey) — bottom of the dep DAG, no cycle.
        member("heart"),
        crate("thiserror"),
        crate("tracing"),
        crate("rlimit"),
        crate("which"),
        crate("serde", features = ["derive"]),
        crate("serde_json"),
        crate("libc"),
        crate("tempfile"),
    ]) + select({
        "prelude//os/constraints:linux": _LINUX_DEPS,
        "DEFAULT": [],
    }),
)

rust_tests(
    prefix = "test",
    deps = deps([
        crate("serde_json"),
        crate("tempfile"),
        member("heart"),
        target(":sandbox"),
    ]),
)
