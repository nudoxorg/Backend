#!/bin/sh
# Run lindsey with the host's GPU driver reachable.
#
# GPUI draws through wgpu, which dlopens libvulkan, which reads an ICD manifest
# naming its vendor library by bare soname — "libGLX_nvidia.so.0", not a path.
# On a non-NixOS host that library lives outside the store, so the directory
# holding it has to be on the loader's search path or no window ever opens
# (lindsey says so itself: "could not open a window … no usable GPU backend").
#
# Why this is a wrapper and not a line in the devshell: putting the host library
# directory on LD_LIBRARY_PATH for the *whole shell* was tried, and it broke the
# build — the Nix JDK picked up the host's libnet.so and nudox-producer-java's
# build script died on `undefined symbol: reuseport_available`. A host library
# directory visible to every compiler and build script in the repo will keep
# finding new ways to do that. Only this process needs it, so only this process
# gets it.
#
# The devshell exports NUDOX_GUI_DRIVER_PATH (/run/opengl-driver/lib on NixOS,
# /usr/lib elsewhere). Override it to point somewhere else.
#
# Usage:  run-lindsey [args…]        — runs target/release/lindsey if built,
#                                      otherwise target/debug/lindsey
#         LINDSEY_BIN=… run-lindsey  — runs an explicit binary

set -eu

driver_path="${NUDOX_GUI_DRIVER_PATH:-}"
if [ -z "$driver_path" ]; then
    if [ -d /run/opengl-driver/lib ]; then
        driver_path=/run/opengl-driver/lib
    elif [ -d /usr/lib ]; then
        driver_path=/usr/lib
    fi
fi

# Appended, never prepended: entries earlier in the path win, so the store
# copies the devshell put there keep priority and the host directory is
# consulted only for what Nix does not provide — above all, not for libc.
if [ -n "$driver_path" ]; then
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}${LD_LIBRARY_PATH:+:}$driver_path"
    export LD_LIBRARY_PATH
fi

here="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

if [ -n "${LINDSEY_BIN:-}" ]; then
    bin="$LINDSEY_BIN"
elif [ -x "$here/target/release/lindsey" ]; then
    bin="$here/target/release/lindsey"
else
    bin="$here/target/debug/lindsey"
fi

if [ ! -x "$bin" ]; then
    echo "run-lindsey: no binary at $bin — build it first (cargo build [--release])" >&2
    exit 1
fi

exec "$bin" "$@"
