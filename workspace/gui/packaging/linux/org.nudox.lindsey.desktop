[Desktop Entry]
Type=Application
Version=1.5

Name=lindsey
GenericName=Code Intelligence Browser
Comment=Browse symbols, signatures and provenance across your dependency graph

# No %U / %F: lindsey does not accept file or URI arguments yet. A field code
# here would make the launcher hand it paths it silently ignores, which reads to
# the user as "opening this file did nothing".
Exec=lindsey
Terminal=false

Icon=org.nudox.lindsey

# The compositor matches a window to this entry by app id. On Wayland that is
# the *only* available signal — a surface carries no icon and no window class —
# so this must equal `app::desktop::APP_ID` and the WindowOptions.app_id built
# from it. `app_id_matches_desktop_entry` pins the two together.
#
# The macOS half of packaging lives beside this directory (the .dmg background);
# this is its Linux counterpart.
StartupWMClass=org.nudox.lindsey
StartupNotify=true

Categories=Development;IDE;
Keywords=code;symbol;documentation;dependencies;nudox;
