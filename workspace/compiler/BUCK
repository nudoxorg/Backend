rust_tests(
    prefix = "test",
    # Sealed producers need go/javadoc/dotnet on PATH; Buck tests do not inherit
    # the devshell's NUDOX_TOOLCHAIN_PATH. Derive bin dirs from .buckconfig.
    env = nudox_toolchain_test_env(),
    # The Go, Java, and C# snapshot tests drive producers that shell out to the
    # vendored oracles; the test binaries need the same resources the
    # `compiler` lib target declares so `buck_resource(..)` resolves at runtime.
    resources = {
        "go-oracle": "//workspace/compiler/compile/go/oracle:oracle",
        "java-oracle.jar": "//workspace/compiler/compile/java/oracle:extractor",
        # Pulls in the dotnet-published oracle.dll directory (CSHARP-PLAN §1.3).
        # `buck_resource("csharp-oracle")` in snap_csharp.rs resolves this at runtime.
        "csharp-oracle": "//workspace/compiler/compile/csharp/oracle:oracle",
    },
    deps = deps([
        member("heart"),
        member("ir"),
        member("registry"),
        member("sandbox"),
        crate("tempfile"),
        crate("serde"),
        crate("serde_json"),
        crate("rustc_hash"),
        crate("uv_pep440"),
        crate("semver"),
        crate("url"),
        crate("snix_eval"),
        crate("bytes"),
        crate("smol_str"),
        crate("insta"),
        crate("arborium"),
        crate("arborium_tree_sitter"),
        crate("postcard"),
        target(":compiler"),
    ]),
)
