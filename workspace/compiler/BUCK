        # C# XML-doc parsing (replaces hand-rolled element scanner).
        crate("quick-xml"),
        # rust-analyzer producer (ra_ap_* 0.0.341; see RUST-ANALYZER-PLAN.md)
        crate("ra_ap_load_cargo"),
        crate("ra_ap_project_model"),
        crate("ra_ap_hir"),
        crate("ra_ap_ide_db"),
