    resources = {
        "go-oracle": "//workspace/compiler/compile/go/oracle:oracle",
        "java-oracle.jar": "//workspace/compiler/compile/java/oracle:extractor",
        # Pulls in the dotnet-published oracle.dll directory (CSHARP-PLAN §1.3).
