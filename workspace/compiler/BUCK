# P0 spike: ra_ap_load_cargo → walk local ModuleDefs (RUST-ANALYZER-PLAN §P0).
# Fixtures ride in srcs so env!("CARGO_MANIFEST_DIR") can find them under buck.
rust_bin(
    name = "ra-spike",
    srcs = ["bin/ra_spike.rs"] + native.glob(["tests/fixtures/rust/regular/**"]),
    crate_root = "bin/ra_spike.rs",
    env = {
        "CARGO_MANIFEST_DIR": ".",
    },
    deps = deps([
        crate("ra_ap_load_cargo"),
        crate("ra_ap_hir"),
        crate("ra_ap_project_model"),
        crate("anyhow"),
        crate("tempfile"),
    ]),
)

