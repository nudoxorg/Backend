        crate("ra_ap_proc_macro_api"),

        crate("arborium"),
        crate("arborium_tree_sitter"),
        crate("uv_pep440"),
        crate("uv_pep508"),
        crate("terminusdb_schema"),
        crate("terminusdb_schema_derive"),
        crate("pyrefly"),
        crate("pyrefly_types"),
        crate("pyrefly_build"),
        crate("pyrefly_python"),
        crate("pyrefly_config"),
        crate("pyrefly_util"),
        crate("ruff_python_ast"),
        crate("tokio"),
        # OXC TypeScript producer (OXC-PLAN.md); in-process OXC + tsz stack.
        crate("oxc_parser"),
