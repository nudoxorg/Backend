        # Tier C — in-process tsz TypeScript checker oracle (git-vendored tsz
        # monorepo @ TSZ_REV; see build/third-party/git.bzl). Drives multi-file
        # check + inference-accurate .d.ts emit, then re-extracts via the OXC
        # Tier-A pipeline. Opt-in via NUDOX_TYPESCRIPT_ORACLE; graceful Tier-A
        # fallback on any failure (tsz is pre-release).
        crate("tsz_core"),
        crate("tsz_emitter"),
        crate("tsz_binder"),
        crate("tsz_parser"),
        crate("tsz_solver"),
        crate("tsz_common"),
