/**
 * An ordered pair of two values where both types must be `Comparable`.
 * 
 * Type parameters:
 * - `T` — the type of both elements; must be `Comparable` to itself
 */
public class SortedPair<T> {
    private T first;
    private T second;
}

// ---

/**
 * Computes the distance between the two elements using `Comparable#compareTo`.
 */
public int distance();

