// <unrendered module>

/**
 * A greeter interface carrying an ordinary method plus a call signature and
 * an index signature.
 */
export interface Greeter {
    /**
     * An ordinary required method.
     */
    greet(name: string): string;
    Call(name: string): string;
    Index(key: string): unknown;
}
