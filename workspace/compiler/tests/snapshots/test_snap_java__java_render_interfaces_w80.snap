/**
 * Anything that can be drawn to a canvas.
 * 
 * Implementors must supply `#draw(String)` and `#resize(double)`.
 *  The `#clear(String)` method has a default no-op implementation.
 */
public interface Drawable {
    void draw(String canvas);
    void resize(double factor);
    double area();
    void clear(String canvas);
}

// ---

/**
 * Returns the bounding area of this shape.
 * 
 * Declared: `abstract`
 */
public double area();

// ---

/**
 * Clears this shape from the canvas.
 * 
 * Default implementation does nothing.
 * 
 * Declared: `default`
 */
public void clear(String canvas);

// ---

/**
 * Draws this shape on the given canvas.
 * 
 * Declared: `abstract`
 */
public void draw(String canvas);

// ---

/**
 * Resizes this shape by the given factor.
 * 
 * Declared: `abstract`
 */
public void resize(double factor);

