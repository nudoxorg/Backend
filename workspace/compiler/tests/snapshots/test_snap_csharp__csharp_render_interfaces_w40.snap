/// A generic repository abstraction for CRUD operations on entities of type
/// `T` identified by `TKey`.
/// 
/// Type parameters:
/// - `TKey` — The primary-key type.
/// - `T` — The entity type.
/// 
/// Declared: `interface`
/// 
/// Declared: `internal`
internal interface IRepository<
    T,
    TKey
> {
    T? GetById(TKey id);
    IEnumerable<T> GetAll();
    void Add(T entity);
    bool Remove(TKey id);
}
