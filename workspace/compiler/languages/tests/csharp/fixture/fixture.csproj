<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# fixture the oracle end-to-end test extracts.

    This project is never referenced by the Rust build: the oracle reads the
    .cs files directly in source mode. It exists so the fixture can be checked
    with a real compiler (`dotnet build` in this directory) — a fixture that
    silently stopped compiling would make the end-to-end test assert against a
    degraded extraction rather than fail.

    Settings mirror what the fixture exercises: nullable reference types must
    be on for `notAnnotated`/`annotated` to be meaningful, and unsafe blocks
    must be allowed for the pointer-taking extension method.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Nudox.Fixture</AssemblyName>
    <RootNamespace>Nudox.Fixture</RootNamespace>
  </PropertyGroup>

</Project>
