<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Nudox C# oracle.

    Framework-dependent so the published output is run as `dotnet oracle.dll`
    (the invocation contract documented in ../src/lib.rs). `RollForward=Major`
    lets the published dll run on a newer shared runtime than it was built
    against, which matters because the nix dotnet SDK pin moves independently
    of this project.

    `RestorePackagesWithLockFile` pins the transitive Roslyn closure into
    packages.lock.json so a rebuild resolves byte-identical inputs; the Buck
    genrule that used to live beside this file passed locked-mode restore to
    enforce that against an offline nix-materialised feed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oracle</AssemblyName>
    <RootNamespace>Nudox.Oracle</RootNamespace>
    <RollForward>Major</RollForward>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Warnings are the point of an extractor: it must not silently drop symbols. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Roslyn 5.6.0 is the version `../src/schema.rs` documents the `roslyn`
      field as carrying; the oracle reports its own loaded version at runtime
      rather than hard-coding that string.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
