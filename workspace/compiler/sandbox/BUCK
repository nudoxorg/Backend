load("//build:rust.bzl", "crate", "deps", "member", "rust_crate", "rust_tests", "target")

rust_crate(
    name = "sandbox",
    deps = deps([
        # Vocabulary crate (ContentHash / JobKey) — bottom of the dep DAG, no cycle.
        member("heart"),
        crate("thiserror"),
        crate("tracing"),
        crate("rlimit"),
        crate("which"),
        crate("serde"),
        crate("serde_json"),
        crate("libc"),
        crate("tempfile"),
    ]),
)

rust_tests(
    prefix = "test",
    deps = deps([
        crate("serde_json"),
        crate("tempfile"),
        member("heart"),
        target(":sandbox"),
    ]),
)
