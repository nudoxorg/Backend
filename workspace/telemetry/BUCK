load("//build:rust.bzl", "crate", "deps", "rust_crate", "rust_tests", "target")

# ── NOT YET VENDORED ──────────────────────────────────────────────────────
# The crate() calls below name third-party crates that do not exist in
# build/third-party/registry.bzl yet (verified: no opentelemetry*, pyroscope*,
# or tracing-opentelemetry entries as of this writing). `crate()` in
# build/rust.bzl calls fail() at analysis time for any unregistered name, so
# THIS FILE WILL NOT PARSE until each of the following is vendored via:
#
#   buck2 run //:add -- opentelemetry
#   buck2 run //:add -- opentelemetry_sdk --features rt-tokio
#   buck2 run //:add -- opentelemetry-otlp --features http-proto
#   buck2 run //:add -- opentelemetry-semantic-conventions
#   buck2 run //:add -- tracing-opentelemetry
#   buck2 run //:add -- opentelemetry-appender-tracing
#   buck2 run //:add -- pyroscope
#   buck2 run //:add -- pyroscope_pprofrs
#
# (tower-http is already vendored — see build/third-party/registry.bzl label
# tower_http-0_6 — so no `add` is needed for Phase 6's TraceLayer.)
#
# `buck2 run //:add` requires crates.io network access; this sandbox returned
# HTTP 403 from crates.io at the time this crate was written, so vendoring
# could not be completed here. See the final report for exact next steps.
rust_crate(
    name = "telemetry",
    deps = deps([
        crate("anyhow"),
        crate("tracing"),
        crate("tracing_subscriber", features = ["json", "env-filter", "fmt", "registry"]),
        # Already vendored (registry.bzl: metrics-0_24, metrics_exporter_prometheus-0_16,
        # metrics_util-0_19) — the metrics->OTLP fan-out in metrics_bridge.rs needs
        # no crates.io access, unlike the opentelemetry entries below.
        crate("metrics"),
        crate("metrics_exporter_prometheus"),
        crate("metrics_util"),
        crate("opentelemetry"),
        crate("opentelemetry_sdk", features = ["rt-tokio"]),
        crate("opentelemetry-otlp", features = ["http-proto", "reqwest-client"]),
        crate("opentelemetry-semantic-conventions"),
        crate("tracing-opentelemetry"),
        crate("opentelemetry-appender-tracing"),
        crate("pyroscope"),
        crate("pyroscope_pprofrs"),
    ]),
)

rust_tests(
    prefix = "test",
    deps = deps([
        crate("tokio"),
        target(":telemetry"),
    ]),
)
