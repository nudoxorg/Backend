load("//build:rust.bzl", "crate", "deps", "member", "rust_bin", "rust_crate", "rust_tests", "target")

rust_crate(
    name = "server-lib",
    srcs = native.glob(["**/*.rs"], exclude = ["main.rs", "tests/**"]),
    crate = "server",
    deps = deps([
        member("heart"),
        member("registry"),
        member("runtime"),
        member("ir"),
        member("compiler"),
        member("sandbox"),
        crate("moka", features = ["sync", "future"]),
        crate("tempfile"),
        crate("libsqlite3_sys", features = ["bundled"]),
        crate("strum", features = ["derive"]),
        crate("uv_pep440", features = ["version-ranges", "serde"]),
        crate("rustix", features = ["use-libc"]),
        # axum speaks http 1.x; the bare `http` alias resolves to the vendored 0.2 build.
        crate("http-1"),
        crate("tokio"),
        crate("tokio_stream"),
        # `futures` alias resolves to 0.1; server needs the 0.3 API surface.
        crate("futures-0_3", features = ["std", "async-await", "alloc"]),
        crate("futures_util"),
        crate("async_stream"),
        crate("bytes"),
        crate("axum"),
        crate("tower", features = ["retry", "timeout", "util"]),
        crate("tower_http"),
        crate("hyper"),
        crate("http_body_util"),
        crate("serde"),
        crate("serde_json"),
        crate("toml"),
        crate("nonempty"),
        crate("sqlx"),
        crate("qdrant_client"),
        crate("reqwest"),
        crate("object_store"),
        crate("chrono"),
        crate("smol_str"),
        crate("semver"),
        crate("url"),
        crate("uuid"),
        crate("figment"),
        crate("secrecy"),
        crate("thiserror"),
        crate("anyhow"),
        crate("tracing"),
        crate("tracing_subscriber"),
        crate("metrics"),
        crate("metrics_exporter_prometheus"),
        crate("arc_swap"),
        crate("mimalloc"),
    ]),
)

rust_tests(
    prefix = "test",
    deps = deps([
        member("heart"),
        member("registry"),
        member("runtime"),
        member("compiler"),
        member("ir"),
        crate("http-1"),
        crate("axum"),
        crate("tower"),
        crate("tokio"),
        crate("futures-0_3", features = ["std", "async-await", "alloc"]),
        crate("chrono"),
        crate("http_body_util"),
        crate("nonempty"),
        crate("serde_json"),
        crate("smol_str"),
        crate("uuid"),
        crate("tempfile"),
        target(":server-lib"),
    ]),
)

rust_bin(
    name = "server",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    crate = "server_bin",
    deps = deps([
        member("runtime"),
        member("compiler"),
        member("sandbox"),
        crate("tokio"),
        crate("anyhow"),
        crate("mimalloc"),
        crate("tracing"),
        crate("tracing_subscriber"),
        target(":server-lib"),
    ]),
)