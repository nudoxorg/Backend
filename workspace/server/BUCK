        crate("rustix", features = ["use-libc"]),
        # axum speaks http 1.x; the bare `http` alias resolves to the vendored 0.2 build.
        crate("http-1"),
        crate("tokio"),
        crate("tokio_stream"),
        # `futures` alias resolves to 0.1; server needs the 0.3 API surface.
        crate("futures-0_3", features = ["std", "async-await", "alloc"]),
        crate("futures_util"),
        crate("async_stream"),
        crate("bytes"),
        crate("axum"),
        crate("tower", features = ["retry", "timeout", "util"]),
        crate("tower_http", features = ["trace"]),
        crate("hyper"),
        crate("http_body_util"),
        crate("serde"),
        crate("serde_json"),
        crate("toml"),
        crate("nonempty"),
        crate("sqlx"),
        crate("qdrant_client"),
        crate("reqwest"),
        crate("object_store"),
        crate("chrono"),
        crate("smol_str"),
        crate("semver"),
        crate("url"),
        crate("uuid"),
        crate("figment"),
        crate("secrecy"),
        crate("thiserror"),
        crate("anyhow"),
        crate("tracing"),
        crate("tracing_subscriber"),
        crate("metrics"),
        crate("arc_swap"),
        crate("async_trait"),
        crate("mimalloc"),
    ]),
)

