load("//build:rust.bzl", "deps", "rust_bin", "rust_crate", "rust_tests")

rust_crate(
    name = "server-lib",
    srcs = native.glob(["**/*.rs"], exclude = ["main.rs"]),
    crate = "server",
    deps = deps(
        members = ["heart", "registry", "runtime", "ir"],
        crates = [
            "tokio",
            "tokio_stream",
            "futures",
            "futures_util",
            "async_stream",
            "bytes",
            "axum",
            "tower",
            "tower_http",
            "hyper",
            "http_body_util",
            "serde",
            "serde_json",
            "toml",
            "nonempty",
            "sqlx",
            "qdrant_client",
            "reqwest",
            "object_store",
            "chrono",
            "strum",
            "smol_str",
            "semver",
            "uv_pep440",
            "url",
            "uuid",
            "figment",
            "secrecy",
            "thiserror",
            "anyhow",
            "tracing",
            "tracing_subscriber",
            "metrics",
            "metrics_exporter_prometheus",
            "arc_swap",
            "moka",
            "mimalloc",
        ],
        # axum speaks http 1.x; the bare `http` alias resolves to the vendored
        # 0.2 build, so the versioned target is named explicitly.
        raw = ["//build/third-party:http-1"],
    ),
)

rust_tests(
    prefix = "test",
    deps = deps(
        members = ["heart", "registry", "runtime"],
        crates = [
            "axum",
            "tower",
            "tokio",
            "futures",
            "chrono",
            "http_body_util",
            "nonempty",
            "serde_json",
            "smol_str",
            "uuid",
        ],
        raw = [":server-lib", "//build/third-party:http-1"],
    ),
)

rust_bin(
    name = "server",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    crate = "server_bin",
    deps = deps(
        members = ["runtime"],
        crates = ["tokio", "anyhow", "mimalloc", "tracing", "tracing_subscriber"],
        raw = [":server-lib"],
    ),
)
