load("//build:rust.bzl", "crate", "deps", "rust_crate", "rust_tests", "target")

rust_crate(
    name = "heart",
    # `telemetry/**` is behind the Cargo `telemetry` feature (off by default);
    # the Buck compiler build never opts in, so its heavy OTLP deps are excluded
    # here to match — only `server` (Cargo-only) compiles that module.
    srcs = native.glob(["**/*.rs"], exclude = ["tests/**", "telemetry/**"]),
    deps = deps([
        crate("uuid"),
        crate("semver"),
        crate("tower"),
        crate("nutype"),
        crate("strum"),
        crate("postcard"),
        crate("uv_pep440"),
        crate("serde"),
        crate("thiserror"),
        crate("blake3"),
        crate("smol_str"),
        crate("compact_str"),
        crate("chrono"),
        crate("ordered_float"),
        crate("data_encoding"),
        crate("url"),
        crate("anyhow"),
    ]),
)

rust_tests(
    prefix = "test",
    deps = deps([
        crate("uuid"),
        crate("semver"),
        crate("tower"),
        crate("tokio"),
        target(":heart"),
    ]),
)
