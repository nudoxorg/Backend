load("//build:rust.bzl", "crate", "deps", "member", "rust_crate", "rust_tests", "target")

rust_crate(
    name = "runtime",
    srcs = native.glob(["**/*.rs"], exclude = ["tests/**"]),
    deps = deps([
        member("heart"),
        member("ir"),
        crate("moka", features = ["sync", "future"]),
        crate("libsqlite3_sys", features = ["bundled"]),
        crate("nonempty"),
        crate("qdrant_client"),
        crate("reqwest"),
        crate("url"),
        crate("secrecy"),
        crate("tokio"),
        crate("tokio_stream"),
        # `futures` alias resolves to 0.1; runtime needs the 0.3 API surface.
        crate("futures-0_3", features = ["std", "async-await", "alloc"]),
        crate("futures_util"),
        crate("serde"),
        crate("serde_json"),
        crate("bytes"),
        crate("sqlx"),
        crate("nutype"),
        crate("thiserror"),
        crate("tower"),
        crate("tracing"),
        crate("governor"),
        crate("smol_str"),
        crate("strum"),
        crate("tantivy"),
        crate("anyhow"),
    ]),
)

rust_tests(
    prefix = "test",
    deps = deps([
        member("heart"),
        crate("futures-0_3", features = ["std", "async-await", "alloc"]),
        crate("proptest"),
        crate("serde_json"),
        crate("tokio"),
        crate("uuid"),
        crate("smol_str"),
        crate("tantivy"),
        crate("tempfile"),
        crate("tracing"),
        target(":runtime"),
    ]),
)